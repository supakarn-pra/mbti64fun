---
import { AXES } from "../data/questions.js";
import { GUILDS, TYPES, ARCHETYPES, guildOf, matchesOf, MATCH_KINDS } from "../data/types.js";
import { ICONS } from "../data/icons.js";
import "../styles/background.css";
import Analytics from "@vercel/analytics/astro";

const GUILD_ORDER = ["SP", "SJ", "NF", "NT"];
const MATCHES = Object.fromEntries(Object.keys(TYPES).map((c) => [c, matchesOf(c)]));
const deepLabel = (k, letter) =>
  AXES[k].a === letter ? AXES[k].chipA || AXES[k].labA : AXES[k].chipB || AXES[k].labB;
const nx = (s) => (s || "").split(" · ")[0];
const guildPalette = `
  :root {
    ${Object.entries(GUILDS)
      .map(([k, g]) => `--g-${k}: ${g.light}; --g-${k}-dark: ${g.dark};`)
      .join(" ")}
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      ${Object.entries(GUILDS)
        .map(([k, g]) => `--g-${k}: ${g.dark}; --g-${k}-dark: ${g.light};`)
        .join(" ")}
    }
  }
  :root[data-theme="dark"] {
    ${Object.entries(GUILDS)
      .map(([k, g]) => `--g-${k}: ${g.dark}; --g-${k}-dark: ${g.light};`)
      .join(" ")}
  }
`;
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ทำเนียบ 64 ตำแหน่ง · ดูครบทุกตำแหน่งในต่างโลก</title>
    <link rel="canonical" href={new URL('dex/', Astro.site)} />
    <link rel="icon" href="../favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="../favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="../apple-touch-icon.png" />
    <meta name="description" content="แบบทดสอบบุคลิกภาพภาษาไทย 78 ข้อ ตอบจบแล้วได้ตำแหน่งในต่างโลก 1 ใน 64 แบบ ทำเล่นกันในทีม" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="64 ตำแหน่งในต่างโลก" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:title" content="ทำเนียบ 64 ตำแหน่ง · ดูครบทุกตำแหน่งในต่างโลก" />
    <meta property="og:description" content="แบบทดสอบบุคลิกภาพภาษาไทย 78 ข้อ ตอบจบแล้วได้ตำแหน่งในต่างโลก 1 ใน 64 แบบ ทำเล่นกันในทีม" />
    <meta property="og:url" content={new URL('dex/', Astro.site)} />
    <meta property="og:image" content={new URL('og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="64 ตำแหน่งในต่างโลก" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ทำเนียบ 64 ตำแหน่ง · ดูครบทุกตำแหน่งในต่างโลก" />
    <meta name="twitter:description" content="แบบทดสอบบุคลิกภาพภาษาไทย 78 ข้อ ตอบจบแล้วได้ตำแหน่งในต่างโลก 1 ใน 64 แบบ ทำเล่นกันในทีม" />
    <meta name="twitter:image" content={new URL('og.png', Astro.site)} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Kanit:wght@500;600&family=IBM+Plex+Sans+Thai:wght@300;400;600&family=IBM+Plex+Mono:wght@500&display=swap"
    />
    <style is:inline set:html={guildPalette}></style>
    <style is:global>
      :root {
        --ground: #EBE7E0;
        --surface: #FBF9F6;
        --line: #D6CFC2;
        --ink: #24201C;
        --ink-soft: #625A50;
        --ink-faint: #8C8376;
        --gold: #8A6A15;
        --on-gold: #FFFCF4;
        --blood: #8E2C33;
        --warn: #A33C1E;
        --shadow: 0 1px 2px rgba(36, 32, 28, .06), 0 20px 44px -26px rgba(36, 32, 28, .5);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --ground: #14121B;
          --surface: #1D1A26;
          --line: #342F41;
          --ink: #F0EBE2;
          --ink-soft: #ADA598;
          --ink-faint: #7E7668;
          --gold: #D9B15A;
          --on-gold: #1A150A;
          --blood: #E58089;
          --warn: #F0956F;
          --shadow: 0 1px 2px rgba(0, 0, 0, .5), 0 20px 44px -26px rgba(0, 0, 0, .95);
        }
      }
      :root[data-theme="dark"] {
        --ground: #14121B;
        --surface: #1D1A26;
        --line: #342F41;
        --ink: #F0EBE2;
        --ink-soft: #ADA598;
        --ink-faint: #7E7668;
        --gold: #D9B15A;
        --on-gold: #1A150A;
        --blood: #E58089;
        --warn: #F0956F;
        --shadow: 0 1px 2px rgba(0, 0, 0, .5), 0 20px 44px -26px rgba(0, 0, 0, .95);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: "IBM Plex Sans Thai", "Noto Sans Thai", "Leelawadee UI", Thonburi, system-ui, sans-serif;
        line-height: 1.75;
      }
      .wrap {
        max-width: 980px;
        margin: 0 auto;
        padding: 24px 20px 56px;
      }
      .fx { font-family: Kanit, "IBM Plex Sans Thai", sans-serif; font-weight: 600; }
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 18px;
      }
      .title {
        font-size: clamp(28px, 6vw, 42px);
        margin: 0;
        line-height: 1.2;
      }
      .home {
        appearance: none;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--ink);
        border-radius: 999px;
        padding: 8px 16px;
        font: inherit;
        cursor: pointer;
      }
      .home:hover { border-color: var(--gold); }
      .sub {
        margin: 0 0 18px;
        color: var(--ink-soft);
        font-size: 14px;
      }
      .dexsec { margin-top: 28px; }
      .gh {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1px solid color-mix(in srgb, var(--g) 40%, var(--line));
        border-left: 4px solid var(--g);
        border-radius: 4px;
        background: color-mix(in srgb, var(--g) 9%, var(--surface));
      }
      .sg { width: 46px; height: 46px; flex: none; display: block; }
      .sg img { display: block; width: 100%; height: 100%; object-fit: contain; }
      .gn {
        font-size: 20px; line-height: 1.3; color: var(--g);
      }
      .gl {
        display: block; font-size: 12px; color: var(--ink-faint); line-height: 1.5;
      }
      .gh em {
        margin-left: auto;
        font-style: normal;
        font-family: "IBM Plex Mono", monospace;
        font-size: 11px;
        color: var(--ink-faint);
      }
      .dexlist {
        list-style: none;
        margin: 12px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 12px;
      }
      .dexlist li {
        background: var(--surface);
        border: 1px solid var(--line);
        border-top: 3px solid var(--g);
        border-radius: 4px;
        padding: 14px 14px 12px;
        box-shadow: var(--shadow);
      }
      .crow {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 9px;
      }
      .av {
        width: 24px; height: 24px; display: grid; place-items: center;
        border-radius: 50%; border: 1px solid color-mix(in srgb, var(--g) 50%, var(--line));
        color: var(--g); font-size: 12px;
      }
      .dc {
        font-family: "IBM Plex Mono", monospace;
        font-size: 11.5px;
        letter-spacing: .12em;
        color: var(--g);
      }
      .meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
      }
      .dn {
        font-family: Kanit, "IBM Plex Sans Thai", sans-serif;
        font-weight: 700;
        font-size: 16.5px;
        line-height: 1.45;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 2px 8px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--g) 35%, var(--line));
        background: color-mix(in srgb, var(--g) 12%, var(--surface));
        color: var(--g);
        font-size: 9.5px;
        letter-spacing: .1em;
        font-weight: 700;
        text-transform: uppercase;
        line-height: 1.6;
      }
      .dt {
        display: block;
        margin: 0 0 6px;
        color: var(--ink-soft);
        font-size: 12.5px;
        line-height: 1.55;
      }
      .ic { width: 1.05em; height: 1.05em; flex: none; stroke-width: 1.6; vertical-align: -.17em; }
      .av .ic { width: 62%; height: 62%; vertical-align: 0; }
      a.home { text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }

      .thumb { display: block; width: 100%; max-width: 132px; height: auto; margin: 2px auto 6px; }
      .sheetpic {
        display: block; width: min(210px, 58%); height: auto; margin: 0 auto 10px;
        filter: drop-shadow(0 6px 14px rgba(20, 14, 30, .22));
      }
      /* ปุ่มใสคลุมทั้งการ์ด กดตรงไหนก็เปิดได้ ส่วน "ดูรายละเอียด" เหลือเป็นแค่ป้ายบอก */
      .hit {
        position: absolute; inset: 0; z-index: 2;
        background: none; border: none; padding: 0; cursor: pointer;
        border-radius: 3px;
      }
      .hit:focus-visible { outline: 2px solid var(--g); outline-offset: 3px; }
      .dexlist li { position: relative; transition: transform .15s ease, box-shadow .15s ease, border-color .15s; }
      .dexlist li:hover { transform: translateY(-3px); border-color: var(--g); box-shadow: 0 10px 22px -14px rgba(20, 14, 30, .55); }
      .dexlist li:hover .more { opacity: 1; }
      .more {
        display: block; margin-top: 10px; font-size: 12px; color: var(--g); opacity: .72;
        border-top: 1px dashed var(--line); padding-top: 9px; transition: opacity .15s;
      }
      .more::after { content: " →"; }

      /* ---------- กล่องรายละเอียด ---------- */
      dialog {
        border: none; padding: 0; background: transparent; color: var(--ink);
        max-width: min(560px, 100vw - 32px); width: 100%;
      }
      dialog::backdrop { background: rgba(10, 8, 16, .55); backdrop-filter: blur(3px); }
      .sheetbox {
        position: relative; background: var(--surface); border: 1px solid var(--g);
        border-top: 4px solid var(--g); border-radius: 4px;
        padding: 30px 24px 26px; max-height: 86vh; overflow-y: auto;
      }
      dialog[open] .sheetbox { animation: pop .22s ease; }
      @keyframes pop { from { opacity: 0; transform: translateY(12px); } }
      .x {
        position: absolute; top: 12px; right: 12px; width: 34px; height: 34px;
        display: grid; place-items: center; color: var(--ink-faint);
        background: none; border: 1px solid var(--line); border-radius: 50%; cursor: pointer;
      }
      .x:hover { color: var(--ink); border-color: var(--ink-faint); }
      .x .ic { width: 17px; height: 17px; vertical-align: 0; }
      .sheetbox .guild { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
      .sheetbox .sigil { width: 52px; height: 52px; flex: none; display: block; }
      .sheetbox .sigil img { display: block; width: 100%; height: 100%; object-fit: contain; }
      .sheetbox .gname { font-size: 17px; line-height: 1.3; }
      .sheetbox .gline { display: block; font-size: 12.5px; color: var(--ink-faint); line-height: 1.5; }
      .sheetbox .code { font-family: "IBM Plex Mono", monospace; font-size: 15px; letter-spacing: .22em; color: var(--g); margin: 0; }
      .sheetbox .nick { font-size: clamp(26px, 6.5vw, 36px); line-height: 1.35; margin: 4px 0 10px; text-wrap: balance; }
      .sheetbox .tag { margin: 0; color: var(--ink-soft); font-size: 15.5px; line-height: 1.7; }
      .sheetbox .archetype {
        margin: 10px 0 0; font-family: "IBM Plex Mono", monospace; font-size: 11.5px;
        letter-spacing: .08em; color: var(--ink-faint);
      }
      .over {
        margin: 20px 0 0; padding-top: 18px; border-top: 1px solid var(--line);
        font-size: 15px; line-height: 1.85; color: var(--ink-soft);
      }
      .facts { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-direction: column; gap: 13px; }
      .facts li { display: flex; flex-direction: column; gap: 2px; }
      .fk { font-size: 11.5px; color: var(--ink-faint); }
      .facts p { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--ink); }
      .sect { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--line); }
      .sect h3 {
        font-family: Kanit, "IBM Plex Sans Thai", sans-serif; font-weight: 600; font-size: 17px;
        margin: 0 0 12px; line-height: 1.4;
      }
      .axes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
      .axes li { display: flex; gap: 11px; align-items: flex-start; }
      .axes .al { flex: none; width: 84px; font-size: 12px; color: var(--ink-faint); padding-top: 2px; }
      .axes .ab { flex: 1; min-width: 0; border-left: 2px solid var(--a); padding-left: 11px; }
      .axes b { display: block; font-size: 14px; color: var(--a); line-height: 1.5; }
      .axes i { font-style: normal; font-size: 13px; color: var(--ink-soft); line-height: 1.6; }

      .pairs { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
      .pairs li {
        display: flex; gap: 12px; align-items: flex-start;
        border: 1px solid var(--line); border-left: 3px solid var(--p);
        border-radius: 3px; padding: 12px 14px;
      }
      .pairs img { flex: none; width: 64px; height: 64px; object-fit: contain; }
      .pairs .pk {
        display: inline-block; font-size: 11px; color: var(--p);
        border: 1px solid var(--p); border-radius: 999px; padding: 0 8px; margin-right: 6px;
      }
      .pairs .pc { font-family: "IBM Plex Mono", monospace; font-size: 11.5px; letter-spacing: .1em; color: var(--ink-faint); }
      .pairs .pn { display: block; font-family: Kanit, "IBM Plex Sans Thai", sans-serif; font-weight: 600; font-size: 16px; line-height: 1.45; margin: 3px 0 2px; }
      .pairs .pw { font-style: normal; font-size: 12.5px; color: var(--ink-soft); line-height: 1.6; }

      .grow {
        margin: 16px 0 0; padding: 13px 15px; font-size: 14.5px; line-height: 1.65; color: var(--ink);
        background: color-mix(in srgb, var(--g) 10%, var(--surface));
        border-left: 3px solid var(--g); border-radius: 0 3px 3px 0;
      }
      .chips span { white-space: nowrap; }
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding-top: 8px;
        margin-top: 8px;
        border-top: 1px dashed var(--line);
      }
      .chips span {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0 8px;
        color: var(--ink-faint);
        font-size: 11px;
        line-height: 1.7;
      }
      /* ---------- จอมือถือ ---------- */
      @media (max-width: 560px) {
        .wrap { padding: 18px 14px 44px; }
        /* หัวหน้ากับปุ่มกลับอยู่บรรทัดเดียวกัน ไม่ต้องหล่นลงมาซ้อน */
        .topbar { gap: 10px; margin-bottom: 14px; }
        .title { font-size: 25px; }
        .home { flex: none; padding: 7px 12px; font-size: 13px; }
        .sub { font-size: 13px; }

        /* หัวสังกัด: จำนวนตำแหน่งหล่นลงบรรทัดใหม่ ไม่เบียดชื่อ */
        .gh { flex-wrap: wrap; padding: 10px 12px; gap: 9px; }
        .sg { width: 38px; height: 38px; }
        .gn { font-size: 17px; }
        .gh em { margin-left: 0; width: 100%; align-self: auto; }

        /* การ์ดสองคอลัมน์แบบอัลบั้มสติกเกอร์ รายละเอียดที่เหลือไปดูใน modal */
        .dexlist { grid-template-columns: 1fr 1fr; gap: 9px; }
        .dexlist li { padding: 10px 10px 9px; }
        .crow { flex-wrap: wrap; gap: 5px 6px; }
        .dc { font-size: 10.5px; letter-spacing: .08em; }
        .badge { font-size: 9.5px; padding: 0 5px; }
        .thumb { max-width: 100%; margin-bottom: 4px; }
        .dn { font-size: 14.5px; }
        .dt, .chips { display: none; }
        .more { font-size: 11px; padding-top: 7px; margin-top: 8px; }

        .sheetbox { padding: 24px 16px 20px; }
        .axes li { flex-direction: column; gap: 3px; }
        .axes .al { width: auto; }
        .axes .ab { padding-left: 9px; }
        .pairs li { flex-direction: column; gap: 8px; }
        .pairs img { width: 72px; height: 72px; }
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <div class="topbar">
        <h1 class="title fx">ทำเนียบ 64 ตำแหน่ง</h1>
        <a class="home" href="../"><svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={ICONS.back} />กลับหน้าแรก</a>
      </div>
      <p class="sub">ทะเบียนพนักงานทั้งอาณาจักร แบ่งตาม 4 สังกัด สังกัดละ 16 ตำแหน่ง</p>

      {GUILD_ORDER.map((key) => {
        const g = GUILDS[key];
        return (
          <section class="dexsec" style={`--g: var(--g-${key});`}>
            <div class="gh">
              <span class="sg"><img src={`../crest/${key}.webp`} alt="" width="160" height="160" decoding="async" /></span>
              <div>
                <div class="gn fx">{g.name}</div>
                <span class="gl">{g.line}</span>
              </div>
              <em>16 ตำแหน่ง</em>
            </div>

            <ul class="dexlist">
              {Object.keys(TYPES)
                .filter((code) => guildOf(code.slice(0, 4)) === key)
                .map((code) => {
                  const { name: nick, tag } = TYPES[code];
                  const base = code.slice(0, 4);
                  return (
                    <li style={`--g: var(--g-${key});`}>
                      <button class="hit" type="button" data-code={code} aria-label={`ดูรายละเอียด ${nick}`}></button>
                      <div class="crow">
                        <span class="av"><svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={ICONS[g.icon]} /></span>
                        <span class="dc">{code}</span>
                        <span class="badge">{nx(ARCHETYPES[base])}</span>
                      </div>
                      <img class="thumb" src={`../mob/${code}.webp`} alt="" width="320" height="320" loading="lazy" decoding="async" />
                      <div class="meta">
                        <span class="dn">{nick}</span>
                      </div>
                      <span class="dt">{tag}</span>
                      <div class="chips">
                        <span>{deepLabel(4, code[5])}</span>
                        <span>{deepLabel(5, code[6])}</span>
                      </div>
                      <span class="more">ดูรายละเอียด</span>
                    </li>
                  );
                })}
            </ul>
          </section>
        );
      })}

      <dialog id="sheet" aria-label="รายละเอียดตำแหน่ง">
        <div class="sheetbox">
          <button class="x" type="button" id="sheet-close" aria-label="ปิด">
            <svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={ICONS.close} />
          </button>
          <img class="sheetpic" id="s-pic" alt="" width="320" height="320" decoding="async" />
          <div class="guild">
            <span class="sigil" id="s-sigil"></span>
            <span>
              <span class="gname fx" id="s-guild"></span>
              <span class="gline" id="s-line"></span>
            </span>
          </div>
          <p class="code" id="s-code"></p>
          <h2 class="nick fx" id="s-name"></h2>
          <p class="tag" id="s-tag"></p>
          <p class="archetype" id="s-arch"></p>
          <p class="over" id="s-over"></p>
          <ul class="facts">
            <li><span class="fk">จุดแข็งในงาน</span><p id="s-good"></p></li>
            <li><span class="fk">จุดที่ต้องระวัง</span><p id="s-care"></p></li>
            <li><span class="fk">สายงานที่เหมาะ</span><p id="s-roles"></p></li>
          </ul>
          <p class="grow" id="s-grow"></p>
          <div class="sect">
            <h3>ค่าสถานะ 6 แกน</h3>
            <ul class="axes" id="s-axes"></ul>
          </div>
          <div class="sect">
            <h3>เข้ากับใครได้ดี</h3>
            <ul class="pairs" id="s-pairs"></ul>
          </div>
        </div>
      </dialog>
    </main>

    <script is:inline define:vars={{ TYPES, GUILDS, ARCHETYPES, ICONS, AXES, MATCHES, MATCH_KINDS }}>
      const guildOf = (b) => (b[1] === "N" ? (b[2] === "T" ? "NT" : "NF") : b[3] === "J" ? "SJ" : "SP");
      const sheet = document.getElementById("sheet");
      const $ = (id) => document.getElementById(id);

      document.querySelectorAll(".hit").forEach((b) => {
        b.onclick = () => {
          const code = b.dataset.code, t = TYPES[code], key = guildOf(code.slice(0, 4)), g = GUILDS[key];
          sheet.style.setProperty("--g", "var(--g-" + key + ")");
          $("s-pic").src = "../mob/" + code + ".webp";
          $("s-sigil").innerHTML = '<img src="../crest/' + key + '.webp" alt="" width="160" height="160" decoding="async">';
          $("s-guild").textContent = g.name;
          $("s-line").textContent = g.line;
          $("s-code").textContent = code;
          $("s-name").textContent = t.name;
          $("s-tag").textContent = t.tag;
          $("s-arch").textContent = "Archetype · " + (ARCHETYPES[code.slice(0, 4)] || "");
          $("s-over").textContent = t.over;
          $("s-good").textContent = t.good;
          $("s-care").textContent = t.care;
          $("s-roles").textContent = t.roles.join(" · ");
          $("s-grow").textContent = t.grow;

          // ไล่ทีละแกนว่ารหัสนี้อยู่ขั้วไหน แล้วหยิบคำอธิบายของขั้วนั้นมา
          const ls = [code[0], code[1], code[2], code[3], code[5], code[6]];
          const ax = $("s-axes");
          ax.innerHTML = "";
          AXES.forEach((x, i) => {
            const first = ls[i] === x.a;
            const li = document.createElement("li");
            li.style.setProperty("--a", "var(--c-" + x.key + ")");
            li.innerHTML = '<span class="al"></span><span class="ab"><b></b><i></i></span>';
            li.querySelector(".al").textContent = x.name;
            li.querySelector("b").textContent = "(" + ls[i] + ") " + (first ? x.labA : x.labB);
            li.querySelector("i").textContent = first ? x.descA : x.descB;
            ax.appendChild(li);
          });

          const pr = $("s-pairs");
          pr.innerHTML = "";
          (MATCHES[code] || []).forEach((m) => {
            const other = TYPES[m.code], k = MATCH_KINDS[m.kind];
            const gk = guildOf(m.code.slice(0, 4));
            const li = document.createElement("li");
            li.style.setProperty("--p", "var(--g-" + gk + ")");
            li.innerHTML =
              '<img src="../mob/' + m.code + '.webp" alt="" width="320" height="320" loading="lazy" decoding="async">' +
              '<div><span class="pk"></span><span class="pc"></span><b class="pn"></b><i class="pw"></i></div>';
            li.querySelector(".pk").textContent = k.label;
            li.querySelector(".pc").textContent = m.code;
            li.querySelector(".pn").textContent = other.name;
            li.querySelector(".pw").textContent = k.why;
            pr.appendChild(li);
          });

          sheet.showModal();
        };
      });

      $("sheet-close").onclick = () => sheet.close();
      // กดพื้นที่นอกกล่องแล้วปิด
      sheet.addEventListener("click", (e) => { if (e.target === sheet) sheet.close(); });
    </script>
    <Analytics />
  </body>
</html>
