---
import { AXES } from "../data/questions.js";
import { GUILDS, TYPES, ARCHETYPES, guildOf } from "../data/types.js";
import { ICONS } from "../data/icons.js";

const GUILD_ORDER = ["SP", "SJ", "NF", "NT"];
const deepLabel = (k, letter) =>
  AXES[k].a === letter ? AXES[k].chipA || AXES[k].labA : AXES[k].chipB || AXES[k].labB;
const nx = (s) => (s || "").split(" · ")[0];
const guildPalette = `
  :root {
    ${Object.entries(GUILDS)
      .map(([k, g]) => `--g-${k}: ${g.light}; --g-${k}-dark: ${g.dark};`)
      .join(" ")}
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      ${Object.entries(GUILDS)
        .map(([k, g]) => `--g-${k}: ${g.dark}; --g-${k}-dark: ${g.light};`)
        .join(" ")}
    }
  }
  :root[data-theme="dark"] {
    ${Object.entries(GUILDS)
      .map(([k, g]) => `--g-${k}: ${g.dark}; --g-${k}-dark: ${g.light};`)
      .join(" ")}
  }
`;
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ทำเนียบ 64 ตำแหน่ง · ดูครบทุกตำแหน่งในต่างโลก</title>
    <link rel="canonical" href={new URL('dex/', Astro.site)} />
    <link rel="icon" href="../favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="../favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="../apple-touch-icon.png" />
    <meta name="description" content="แบบทดสอบบุคลิกภาพภาษาไทย 78 ข้อ ตอบจบแล้วได้ตำแหน่งในต่างโลก 1 ใน 64 แบบ ทำเล่นกันในทีม" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="64 ตำแหน่งในต่างโลก" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:title" content="ทำเนียบ 64 ตำแหน่ง · ดูครบทุกตำแหน่งในต่างโลก" />
    <meta property="og:description" content="แบบทดสอบบุคลิกภาพภาษาไทย 78 ข้อ ตอบจบแล้วได้ตำแหน่งในต่างโลก 1 ใน 64 แบบ ทำเล่นกันในทีม" />
    <meta property="og:url" content={new URL('dex/', Astro.site)} />
    <meta property="og:image" content={new URL('og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="64 ตำแหน่งในต่างโลก" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ทำเนียบ 64 ตำแหน่ง · ดูครบทุกตำแหน่งในต่างโลก" />
    <meta name="twitter:description" content="แบบทดสอบบุคลิกภาพภาษาไทย 78 ข้อ ตอบจบแล้วได้ตำแหน่งในต่างโลก 1 ใน 64 แบบ ทำเล่นกันในทีม" />
    <meta name="twitter:image" content={new URL('og.png', Astro.site)} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Srisakdi:wght@400;700&family=Sarabun:wght@300;400;600;700&family=IBM+Plex+Mono:wght@500&display=swap"
    />
    <style is:inline set:html={guildPalette}></style>
    <style is:global>
      :root {
        --ground: #EBE7E0;
        --surface: #FBF9F6;
        --line: #D6CFC2;
        --ink: #24201C;
        --ink-soft: #625A50;
        --ink-faint: #8C8376;
        --gold: #8A6A15;
        --on-gold: #FFFCF4;
        --blood: #8E2C33;
        --warn: #A33C1E;
        --shadow: 0 1px 2px rgba(36, 32, 28, .06), 0 20px 44px -26px rgba(36, 32, 28, .5);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --ground: #14121B;
          --surface: #1D1A26;
          --line: #342F41;
          --ink: #F0EBE2;
          --ink-soft: #ADA598;
          --ink-faint: #7E7668;
          --gold: #D9B15A;
          --on-gold: #1A150A;
          --blood: #E58089;
          --warn: #F0956F;
          --shadow: 0 1px 2px rgba(0, 0, 0, .5), 0 20px 44px -26px rgba(0, 0, 0, .95);
        }
      }
      :root[data-theme="dark"] {
        --ground: #14121B;
        --surface: #1D1A26;
        --line: #342F41;
        --ink: #F0EBE2;
        --ink-soft: #ADA598;
        --ink-faint: #7E7668;
        --gold: #D9B15A;
        --on-gold: #1A150A;
        --blood: #E58089;
        --warn: #F0956F;
        --shadow: 0 1px 2px rgba(0, 0, 0, .5), 0 20px 44px -26px rgba(0, 0, 0, .95);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: Sarabun, "Noto Sans Thai", "Leelawadee UI", Thonburi, system-ui, sans-serif;
        line-height: 1.75;
      }
      .wrap {
        max-width: 980px;
        margin: 0 auto;
        padding: 24px 20px 56px;
      }
      .fx { font-family: Srisakdi, Sarabun, serif; font-weight: 700; }
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 18px;
      }
      .title {
        font-size: clamp(28px, 6vw, 42px);
        margin: 0;
        line-height: 1.2;
      }
      .home {
        appearance: none;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--ink);
        border-radius: 999px;
        padding: 8px 16px;
        font: inherit;
        cursor: pointer;
      }
      .home:hover { border-color: var(--gold); }
      .sub {
        margin: 0 0 18px;
        color: var(--ink-soft);
        font-size: 14px;
      }
      .dexsec { margin-top: 28px; }
      .gh {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1px solid color-mix(in srgb, var(--g) 40%, var(--line));
        border-left: 4px solid var(--g);
        border-radius: 4px;
        background: color-mix(in srgb, var(--g) 9%, var(--surface));
      }
      .sg {
        width: 32px; height: 32px; display: grid; place-items: center;
        border-radius: 50%; background: var(--g); color: var(--surface);
        font-size: 15px; font-weight: 700;
      }
      .gn {
        font-size: 20px; line-height: 1.3; color: var(--g);
      }
      .gl {
        display: block; font-size: 12px; color: var(--ink-faint); line-height: 1.5;
      }
      .gh em {
        margin-left: auto;
        font-style: normal;
        font-family: "IBM Plex Mono", monospace;
        font-size: 11px;
        color: var(--ink-faint);
      }
      .dexlist {
        list-style: none;
        margin: 12px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 12px;
      }
      .dexlist li {
        background: var(--surface);
        border: 1px solid var(--line);
        border-top: 3px solid var(--g);
        border-radius: 4px;
        padding: 14px 14px 12px;
        box-shadow: var(--shadow);
      }
      .crow {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 9px;
      }
      .av {
        width: 24px; height: 24px; display: grid; place-items: center;
        border-radius: 50%; border: 1px solid color-mix(in srgb, var(--g) 50%, var(--line));
        color: var(--g); font-size: 12px;
      }
      .dc {
        font-family: "IBM Plex Mono", monospace;
        font-size: 11.5px;
        letter-spacing: .12em;
        color: var(--g);
      }
      .meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
      }
      .dn {
        font-family: Srisakdi, Sarabun, serif;
        font-weight: 700;
        font-size: 16.5px;
        line-height: 1.45;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 2px 8px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--g) 35%, var(--line));
        background: color-mix(in srgb, var(--g) 12%, var(--surface));
        color: var(--g);
        font-size: 9.5px;
        letter-spacing: .1em;
        font-weight: 700;
        text-transform: uppercase;
        line-height: 1.6;
      }
      .dt {
        display: block;
        margin: 0 0 6px;
        color: var(--ink-soft);
        font-size: 12.5px;
        line-height: 1.55;
      }
      .ic { width: 1.05em; height: 1.05em; flex: none; stroke-width: 1.6; vertical-align: -.17em; }
      .sg .ic, .av .ic { width: 62%; height: 62%; vertical-align: 0; }
      a.home { text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }

      .thumb { display: block; width: 100%; max-width: 132px; height: auto; margin: 2px auto 6px; }
      .sheetpic {
        display: block; width: min(210px, 58%); height: auto; margin: 0 auto 10px;
        filter: drop-shadow(0 6px 14px rgba(20, 14, 30, .22));
      }
      .more {
        margin-top: 10px; width: 100%; text-align: left; font: inherit; font-size: 12px;
        color: var(--g); background: none; cursor: pointer;
        border: none; border-top: 1px dashed var(--line); padding: 9px 0 0;
      }
      .more::after { content: " →"; }
      .more:hover { opacity: .75; }
      .more:focus-visible { outline: 2px solid var(--g); outline-offset: 2px; }

      /* ---------- กล่องรายละเอียด ---------- */
      dialog {
        border: none; padding: 0; background: transparent; color: var(--ink);
        max-width: min(560px, 100vw - 32px); width: 100%;
      }
      dialog::backdrop { background: rgba(10, 8, 16, .55); backdrop-filter: blur(3px); }
      .sheetbox {
        position: relative; background: var(--surface); border: 1px solid var(--g);
        border-top: 4px solid var(--g); border-radius: 4px;
        padding: 30px 24px 26px; max-height: 86vh; overflow-y: auto;
      }
      dialog[open] .sheetbox { animation: pop .22s ease; }
      @keyframes pop { from { opacity: 0; transform: translateY(12px); } }
      .x {
        position: absolute; top: 12px; right: 12px; width: 34px; height: 34px;
        display: grid; place-items: center; color: var(--ink-faint);
        background: none; border: 1px solid var(--line); border-radius: 50%; cursor: pointer;
      }
      .x:hover { color: var(--ink); border-color: var(--ink-faint); }
      .x .ic { width: 17px; height: 17px; vertical-align: 0; }
      .sheetbox .guild { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
      .sheetbox .sigil {
        width: 40px; height: 40px; flex: none; display: grid; place-items: center;
        color: var(--g); border: 1px solid var(--g); border-radius: 50%;
      }
      .sheetbox .sigil .ic { width: 20px; height: 20px; vertical-align: 0; }
      .sheetbox .gname { font-size: 17px; line-height: 1.3; }
      .sheetbox .gline { display: block; font-size: 12.5px; color: var(--ink-faint); line-height: 1.5; }
      .sheetbox .code { font-family: "IBM Plex Mono", monospace; font-size: 15px; letter-spacing: .22em; color: var(--g); margin: 0; }
      .sheetbox .nick { font-size: clamp(26px, 6.5vw, 36px); line-height: 1.35; margin: 4px 0 10px; text-wrap: balance; }
      .sheetbox .tag { margin: 0; color: var(--ink-soft); font-size: 15.5px; line-height: 1.7; }
      .sheetbox .archetype {
        margin: 10px 0 0; font-family: "IBM Plex Mono", monospace; font-size: 11.5px;
        letter-spacing: .08em; color: var(--ink-faint);
      }
      .over {
        margin: 20px 0 0; padding-top: 18px; border-top: 1px solid var(--line);
        font-size: 15px; line-height: 1.85; color: var(--ink-soft);
      }
      .facts { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-direction: column; gap: 13px; }
      .facts li { display: flex; flex-direction: column; gap: 2px; }
      .fk { font-size: 11.5px; color: var(--ink-faint); }
      .facts p { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--ink); }
      .grow {
        margin: 16px 0 0; padding: 13px 15px; font-size: 14.5px; line-height: 1.65; color: var(--ink);
        background: color-mix(in srgb, var(--g) 10%, var(--surface));
        border-left: 3px solid var(--g); border-radius: 0 3px 3px 0;
      }
      .chips span { white-space: nowrap; }
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding-top: 8px;
        margin-top: 8px;
        border-top: 1px dashed var(--line);
      }
      .chips span {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0 8px;
        color: var(--ink-faint);
        font-size: 11px;
        line-height: 1.7;
      }
      @media (max-width: 600px) {
        .topbar { align-items: flex-start; flex-direction: column; }
        .home { align-self: flex-end; }
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <div class="topbar">
        <h1 class="title fx">ทำเนียบ 64 ตำแหน่ง</h1>
        <a class="home" href="../"><svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={ICONS.back} />กลับหน้าแรก</a>
      </div>
      <p class="sub">ทะเบียนพนักงานทั้งอาณาจักร แบ่งตาม 4 สังกัด สังกัดละ 16 ตำแหน่ง</p>

      {GUILD_ORDER.map((key) => {
        const g = GUILDS[key];
        return (
          <section class="dexsec" style={`--g: var(--g-${key});`}>
            <div class="gh">
              <span class="sg"><svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={ICONS[g.icon]} /></span>
              <div>
                <div class="gn fx">{g.name}</div>
                <span class="gl">{g.line}</span>
              </div>
              <em>16 ตำแหน่ง</em>
            </div>

            <ul class="dexlist">
              {Object.keys(TYPES)
                .filter((code) => guildOf(code.slice(0, 4)) === key)
                .map((code) => {
                  const { name: nick, tag } = TYPES[code];
                  const base = code.slice(0, 4);
                  return (
                    <li style={`--g: var(--g-${key});`}>
                      <div class="crow">
                        <span class="av"><svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={ICONS[g.icon]} /></span>
                        <span class="dc">{code}</span>
                        <span class="badge">{nx(ARCHETYPES[base])}</span>
                      </div>
                      <img class="thumb" src={`../mob/${code}.webp`} alt="" width="320" height="320" loading="lazy" decoding="async" />
                      <div class="meta">
                        <span class="dn">{nick}</span>
                      </div>
                      <span class="dt">{tag}</span>
                      <div class="chips">
                        <span>{deepLabel(4, code[5])}</span>
                        <span>{deepLabel(5, code[6])}</span>
                      </div>
                      <button class="more" type="button" data-code={code}>ดูรายละเอียด</button>
                    </li>
                  );
                })}
            </ul>
          </section>
        );
      })}

      <dialog id="sheet" aria-label="รายละเอียดตำแหน่ง">
        <div class="sheetbox">
          <button class="x" type="button" id="sheet-close" aria-label="ปิด">
            <svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={ICONS.close} />
          </button>
          <img class="sheetpic" id="s-pic" alt="" width="320" height="320" decoding="async" />
          <div class="guild">
            <span class="sigil" id="s-sigil"></span>
            <span>
              <span class="gname fx" id="s-guild"></span>
              <span class="gline" id="s-line"></span>
            </span>
          </div>
          <p class="code" id="s-code"></p>
          <h2 class="nick fx" id="s-name"></h2>
          <p class="tag" id="s-tag"></p>
          <p class="archetype" id="s-arch"></p>
          <p class="over" id="s-over"></p>
          <ul class="facts">
            <li><span class="fk">จุดแข็งในงาน</span><p id="s-good"></p></li>
            <li><span class="fk">จุดที่ต้องระวัง</span><p id="s-care"></p></li>
            <li><span class="fk">สายงานที่เหมาะ</span><p id="s-roles"></p></li>
          </ul>
          <p class="grow" id="s-grow"></p>
        </div>
      </dialog>
    </main>

    <script is:inline define:vars={{ TYPES, GUILDS, ARCHETYPES, ICONS }}>
      const guildOf = (b) => (b[1] === "N" ? (b[2] === "T" ? "NT" : "NF") : b[3] === "J" ? "SJ" : "SP");
      const sheet = document.getElementById("sheet");
      const $ = (id) => document.getElementById(id);

      document.querySelectorAll(".more").forEach((b) => {
        b.onclick = () => {
          const code = b.dataset.code, t = TYPES[code], key = guildOf(code.slice(0, 4)), g = GUILDS[key];
          sheet.style.setProperty("--g", "var(--g-" + key + ")");
          $("s-pic").src = "../mob/" + code + ".webp";
          $("s-sigil").innerHTML = '<svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true">' + (ICONS[g.icon] || "") + "</svg>";
          $("s-guild").textContent = g.name;
          $("s-line").textContent = g.line;
          $("s-code").textContent = code;
          $("s-name").textContent = t.name;
          $("s-tag").textContent = t.tag;
          $("s-arch").textContent = "Archetype · " + (ARCHETYPES[code.slice(0, 4)] || "");
          $("s-over").textContent = t.over;
          $("s-good").textContent = t.good;
          $("s-care").textContent = t.care;
          $("s-roles").textContent = t.roles.join(" · ");
          $("s-grow").textContent = t.grow;
          sheet.showModal();
        };
      });

      $("sheet-close").onclick = () => sheet.close();
      // กดพื้นที่นอกกล่องแล้วปิด
      sheet.addEventListener("click", (e) => { if (e.target === sheet) sheet.close(); });
    </script>
  </body>
</html>
