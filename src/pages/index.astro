/>

<style is:inline set:html={axisPalette}></style>

<style is:global>
  :root {
    --ground: #EBE7E0;
    --surface: #FBF9F6;
    --line: #D6CFC2;
    --ink: #24201C;
    --ink-soft: #625A50;
    --ink-faint: #8C8376;
    --gold: #8A6A15;
    --on-gold: #FFFCF4;
    --blood: #8E2C33;
    --warn: #A33C1E;
    --shadow: 0 1px 2px rgba(36, 32, 28, .06), 0 20px 44px -26px rgba(36, 32, 28, .5);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #14121B;
      --surface: #1D1A26;
      --line: #342F41;
      --ink: #F0EBE2;
      --ink-soft: #ADA598;
      --ink-faint: #7E7668;
      --gold: #D9B15A;
      --on-gold: #1A150A;
      --blood: #E58089;
      --warn: #F0956F;
      --shadow: 0 1px 2px rgba(0, 0, 0, .5), 0 20px 44px -26px rgba(0, 0, 0, .95);
    }
  }
  :root[data-theme="dark"] {
    --ground: #14121B;
    --surface: #1D1A26;
    --line: #342F41;
    --ink: #F0EBE2;
    --ink-soft: #ADA598;
    --ink-faint: #7E7668;
    --gold: #D9B15A;
    --on-gold: #1A150A;
    --blood: #E58089;
    --warn: #F0956F;
    --shadow: 0 1px 2px rgba(0, 0, 0, .5), 0 20px 44px -26px rgba(0, 0, 0, .95);
  }

  * { box-sizing: border-box; }
  /* ต้องมี ไม่งั้น hidden ไม่ชนะ display:flex ของ .start / .stage */
  [hidden] { display: none !important; }
  body {
    background: var(--ground);
    color: var(--ink);
    font-family: Sarabun, "Noto Sans Thai", "Leelawadee UI", Thonburi, system-ui, sans-serif;
    font-weight: 400;
    line-height: 1.75;
  }
  .wrap { max-width: 620px; margin: 0 auto; padding-inline: 20px; padding-block: 0 56px; }
  .fx { font-family: Srisakdi, Sarabun, serif; font-weight: 700; }
  /* ไอคอนเส้นจาก HugeIcons ใช้สีตามข้อความรอบ ๆ */
  .ic { width: 1.05em; height: 1.05em; flex: none; stroke-width: 1.6; vertical-align: -.17em; }

  /* ---------- แถบบน ---------- */
  .top {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: blur(10px);
    margin-inline: -20px; padding: 12px 20px 10px;
    border-bottom: 1px solid var(--line);
  }
  .brow { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mark { font-size: 19px; line-height: 1.4; letter-spacing: .01em; }
  .mark span { color: var(--gold); }
  /* ---------- แถวมอนสเตอร์ 6 ตัว หลอดเลือดคือความคืบหน้าของแต่ละแกน ---------- */
  .segs { display: flex; gap: 6px; margin-top: 8px; }
  .seg { flex: 1; position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .face { display: block; color: var(--ink-faint); transition: color .2s, transform .2s; }
  .face svg { display: block; width: 22px; height: 22px; stroke-width: 1.5; }
  .hp { display: block; width: 100%; height: 5px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .hp i { display: block; height: 100%; width: 0; background: var(--sc); transition: width .3s ease; }
  .seg[data-live="1"] .face { color: var(--sc); transform: scale(1.18); }
  .seg[data-live="1"] .hp { background: color-mix(in srgb, var(--sc) 25%, var(--line)); }
  /* ล้มแล้ว หรี่ทั้งตัว */
  .seg[data-dead="1"] { opacity: .35; }
  .seg[data-dead="1"] .face { transform: rotate(90deg); }

  .seg.hit .face { animation: shake .4s ease; }
  @keyframes shake {
    0%, 100% { transform: scale(1.18) translateX(0) rotate(0); }
    20% { transform: scale(1.32) translateX(-3px) rotate(-12deg); }
    50% { transform: scale(1.32) translateX(3px) rotate(12deg); }
    80% { transform: scale(1.22) translateX(-2px) rotate(-5deg); }
  }
  .seg.slay .face { animation: slay .6s ease forwards; }
  @keyframes slay {
    0% { transform: scale(1.3); }
    40% { transform: scale(1.5) rotate(20deg); color: var(--sc); }
    100% { transform: rotate(90deg) scale(.9); }
  }
  .dmg {
    position: absolute; top: -2px; left: 50%; pointer-events: none;
    font-family: "IBM Plex Mono", monospace; font-size: 12px; font-weight: 500;
    color: var(--sc); text-shadow: 0 1px 0 var(--ground);
    animation: dmg .75s ease forwards;
  }
  @keyframes dmg {
    0% { transform: translate(-50%, 0) scale(.8); opacity: 0; }
    25% { transform: translate(-50%, -8px) scale(1.15); opacity: 1; }
    100% { transform: translate(-50%, -24px) scale(1); opacity: 0; }
  }

  /* ---------- ใบประเมิน ---------- */
  .intro {
    margin: 22px 0 0; font-size: 13.5px; color: var(--ink-faint);
    display: flex; align-items: center; gap: 10px;
  }
  .intro::before, .intro::after { content: ""; height: 1px; background: var(--line); flex: 1; }
  .stage { padding-top: 18px; }
  .card {
    background: color-mix(in srgb, var(--c) 6%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--c) 30%, var(--line));
    border-radius: 4px; box-shadow: var(--shadow);
    padding: 28px 24px 24px; position: relative;
  }
  .card::before {
    content: ""; position: absolute; inset: 5px; border: 1px solid color-mix(in srgb, var(--c) 18%, transparent);
    border-radius: 2px; pointer-events: none;
  }
  .card.turn { animation: slip .28s ease; }
  @keyframes slip { from { opacity: 0; transform: translateY(10px); } }
  .qnum { display: flex; align-items: center; gap: 7px; font-size: 12.5px; letter-spacing: .04em; color: var(--c); margin: 0 0 12px; font-weight: 600; }
  .dep { width: 6px; height: 6px; border-radius: 50%; flex: none; opacity: .8; }
  .qtext { font-size: clamp(20px, 5vw, 25px); line-height: 1.6; font-weight: 400; margin: 0 0 24px; text-wrap: pretty; }
  .opts { display: flex; flex-direction: column; gap: 9px; }
  .opts button {
    display: flex; align-items: center; gap: 13px; width: 100%; text-align: left;
    font-family: inherit; font-size: 16px; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 3px; padding: 12px 15px; cursor: pointer;
    transition: border-color .15s, background .15s, transform .1s;
  }
  .opts button:hover { border-color: var(--c); transform: translateX(3px); }
  .opts button:focus-visible { outline: 2px solid var(--c); outline-offset: 2px; }
  .emo {
    flex: none; width: 34px; text-align: center; line-height: 1;
    filter: grayscale(.45); opacity: .8;
    transition: transform .18s ease, filter .18s, opacity .18s;
  }
  .opts button[data-strength="2"] .emo { font-size: 27px; }
  .opts button[data-strength="1"] .emo { font-size: 22px; }
  .opts button:hover .emo, .opts button:focus-visible .emo {
    filter: none; opacity: 1; animation: dook .45s ease-in-out infinite;
  }
  @keyframes dook {
    0%, 100% { transform: scale(1.3) rotate(-9deg); }
    50% { transform: scale(1.3) rotate(9deg); }
  }
  .opts button[aria-pressed="true"] { border-color: var(--c); background: color-mix(in srgb, var(--c) 13%, var(--surface)); }
  .opts button[aria-pressed="true"] .emo { filter: none; opacity: 1; transform: scale(1.2); }
  .key {
    margin-left: auto; font-family: "IBM Plex Mono", monospace; font-size: 11px; color: var(--ink-faint);
    border: 1px solid var(--line); border-radius: 3px; padding: 0 6px; flex: none;
  }
  @media (max-width: 430px) { .key { display: none; } }

  .under { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 16px; }
  .under .left { flex: 1; text-align: center; }
  .ghost { display: inline-flex; align-items: center; gap: 6px; font-family: inherit; font-size: 14px; color: var(--ink-soft); background: none; border: none; cursor: pointer; padding: 6px 0; }
  .ghost:hover { color: var(--ink); }
  .ghost:disabled { opacity: .35; cursor: default; }
  .ghost:focus-visible { outline: 2px solid var(--ink-faint); outline-offset: 2px; }
  .left { font-size: 13px; color: var(--ink-faint); }

  /* ---------- บัตรประจำตัว ---------- */
  #result[hidden] { display: none; }
  .rcard {
    background: var(--surface); border: 1px solid var(--gold);
    border-radius: 4px; box-shadow: var(--shadow); padding: 30px 24px; position: relative;
  }
  .rcard::before {
    content: ""; position: absolute; inset: 5px;
    border: 1px solid color-mix(in srgb, var(--gold) 35%, transparent); border-radius: 2px; pointer-events: none;
  }
  /* ไม่ใส่ letter-spacing กับข้อความไทย สระกับวรรณยุกต์จะลอยห่างจากตัวอักษร */
  .issued { font-size: 12px; color: var(--ink-faint); margin: 0 0 4px; }
  .sticker {
    display: block; width: min(230px, 62%); height: auto; margin: 0 auto 6px;
    filter: drop-shadow(0 6px 14px rgba(20, 14, 30, .22));
  }
  .guild { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
  .sigil {
    width: 40px; height: 40px; flex: none; display: grid; place-items: center; font-size: 19px;
    color: var(--gold); border: 1px solid var(--gold); border-radius: 50%;
  }
  .sigil .ic { width: 20px; height: 20px; vertical-align: 0; }
  .gname { font-size: 17px; line-height: 1.3; }
  .gline { display: block; font-family: Sarabun, sans-serif; font-weight: 400; font-size: 12.5px; color: var(--ink-faint); line-height: 1.5; }
  .code { font-family: "IBM Plex Mono", monospace; font-size: 15px; letter-spacing: .22em; color: var(--gold); margin: 0; }
  .nick { font-size: clamp(27px, 7vw, 38px); line-height: 1.35; margin: 4px 0 10px; text-wrap: balance; }
  .tag { margin: 0; color: var(--ink-soft); font-size: 15.5px; }
  .archetype {
    margin: 10px 0 0; color: var(--gold); font-size: 12.5px; letter-spacing: .08em;
    text-transform: uppercase; font-weight: 700;
  }

  .stats { list-style: none; margin: 26px 0 0; padding: 20px 0 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 17px; }
  .stats .head { font-size: 12px; color: var(--ink-faint); margin: -4px 0 0; }
  .stat .nm { font-size: 12.5px; color: var(--ink-faint); display: block; margin-bottom: 4px; }
  .pole { display: flex; align-items: baseline; gap: 8px; font-size: 14.5px; line-height: 1.5; }
  .pole .lt { font-family: "IBM Plex Mono", monospace; font-size: 12px; flex: none; opacity: .75; }
  .pole .pl { flex: 1; min-width: 0; }
  .pole .pc { font-family: "IBM Plex Mono", monospace; font-variant-numeric: tabular-nums; flex: none; }
  .pole[data-win="1"] { color: var(--c); font-weight: 600; }
  .pole[data-win="0"] { color: var(--ink-faint); }
  .bar { height: 7px; border-radius: 4px; background: var(--line); margin: 5px 0; position: relative; overflow: hidden; }
  .bar i { position: absolute; top: 0; bottom: 0; left: 0; background: var(--c); }
  .stat p { margin: 6px 0 0; font-size: 13.5px; color: var(--ink-soft); line-height: 1.6; }

  /* ปุ่มเรียงเป็นกริด ไม่ใช่ flex-wrap จะได้ไม่มีปุ่มหลุดไปอยู่แถวล่างตัวเดียว */
  .tools { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 26px; }
  .tools button {
    display: flex; align-items: center; justify-content: center; gap: 7px;
    font-family: inherit; font-size: 14px; color: var(--ink); background: transparent;
    border: 1px solid var(--line); border-radius: 3px; padding: 11px 14px; cursor: pointer;
    transition: border-color .15s, background .15s;
  }
  .tools button:hover { border-color: var(--gold); }
  .tools button:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  /* ต้องเจาะจงกว่า .tools button ไม่งั้นพื้นหลังโปร่งใสชนะ กลายเป็นตัวหนังสือขาวบนขาว */
  .tools .t-main { background: var(--gold); border-color: var(--gold); color: var(--on-gold); font-weight: 600; }
  .tools .t-main:hover { background: color-mix(in srgb, var(--gold) 86%, var(--ink)); border-color: var(--gold); }
  .t-wide { grid-column: 1 / -1; }
  .t-quiet {
    display: flex; align-items: center; justify-content: center; gap: 7px;
    margin: 14px auto 0; font-family: inherit; font-size: 13.5px; color: var(--ink-faint);
    background: none; border: none; cursor: pointer; padding: 6px 10px;
  }
  .t-quiet:hover { color: var(--ink); }
  .t-quiet:focus-visible { outline: 2px solid var(--ink-faint); outline-offset: 2px; }

  /* ---------- ถามก่อนออกจากแบบทดสอบที่ทำค้างไว้ ---------- */
  dialog { border: none; padding: 0; background: transparent; color: var(--ink); max-width: min(420px, 100vw - 32px); width: 100%; }
  dialog::backdrop { background: rgba(10, 8, 16, .5); backdrop-filter: blur(3px); }
  .leavebox {
    background: var(--surface); border: 1px solid var(--gold); border-top: 4px solid var(--gold);
    border-radius: 4px; padding: 26px 22px 20px;
  }
  dialog[open] .leavebox { animation: pop .2s ease; }
  @keyframes pop { from { opacity: 0; transform: translateY(10px); } }
  .leavebox h2 { font-size: 22px; line-height: 1.4; margin: 0 0 8px; }
  .leavebox p { margin: 0; font-size: 14.5px; line-height: 1.7; color: var(--ink-soft); }
  .leaveact { display: flex; align-items: center; justify-content: flex-end; gap: 6px; margin-top: 20px; }
  .leaveact button {
    font-family: inherit; font-size: 14px; border-radius: 3px; padding: 10px 18px; cursor: pointer;
    background: var(--gold); border: 1px solid var(--gold); color: var(--on-gold); font-weight: 600;
  }
  .leaveact .t-quiet { margin: 0; background: none; border: none; color: var(--ink-faint); font-weight: 400; }
  .leaveact button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  footer { margin-top: 32px; font-size: 12.5px; color: var(--ink-faint); line-height: 1.7; text-align: center; }
  @media (prefers-reduced-motion: reduce) { *, *::before { animation: none !important; transition: none !important; } }

  /* ---------- หน้าเลือกโหมด ---------- */
  .start { display: flex; flex-direction: column; gap: 14px; padding-top: 18px; }
  .resume {
    display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%;
    font-family: inherit; text-align: left; color: var(--ink); cursor: pointer;
    background: color-mix(in srgb, var(--gold) 12%, var(--surface));
    border: 1px solid var(--gold); border-left: 4px solid var(--gold);
    border-radius: 3px; padding: 14px 18px;
  }
  .resume:hover { background: color-mix(in srgb, var(--gold) 18%, var(--surface)); }
  .resume:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .resume .rk { font-size: 12px; color: var(--ink-faint); }
  .resume b { font-family: Srisakdi, Sarabun, serif; font-weight: 700; font-size: 19px; line-height: 1.4; }

  .len { display: flex; gap: 8px; }
  .len button {
    flex: 1; font-family: inherit; font-size: 14.5px; color: var(--ink-soft);
    background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
    padding: 9px 14px; cursor: pointer; transition: border-color .15s, color .15s;
  }
  .len button i { font-style: normal; font-family: "IBM Plex Mono", monospace; font-size: 12px; opacity: .7; font-variant-numeric: tabular-nums; }
  .len button[data-rush="0"] { --t: var(--gold); }
  .len button[data-rush="1"] { --t: var(--blood); }
  .len button:hover { border-color: var(--t); }
  .len button[aria-pressed="true"] { border-color: var(--t); color: var(--t); font-weight: 600; background: color-mix(in srgb, var(--t) 8%, var(--surface)); }
  .len button:focus-visible { outline: 2px solid var(--t); outline-offset: 2px; }
  /* เลือกฉบับรีบแล้ว ให้ทั้งหน้าแรกเปลี่ยนเป็นโทนแดงเลือดหมู */
  .start[data-rush="1"] { --gold: var(--blood); --on-gold: #FFF4F2; }
  .mode {
    display: block; width: 100%; text-align: left; font-family: inherit; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line); border-radius: 4px;
    padding: 18px 20px; cursor: pointer; transition: border-color .15s, transform .1s;
  }
  .mode:hover { border-color: var(--gold); transform: translateY(-2px); }
  .mode:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .mode[aria-expanded="true"] { border-color: var(--gold); }
  .mode b { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-family: Srisakdi, Sarabun, serif; font-weight: 700; font-size: 21px; line-height: 1.4; }
  .mode b em { flex: none; font-variant-numeric: tabular-nums; }
  .ask .go { font-variant-numeric: tabular-nums; }
  .mode span { display: block; font-size: 13.5px; color: var(--ink-soft); line-height: 1.6; margin-top: 3px; }
  .mode em { font-style: normal; font-family: "IBM Plex Mono", monospace; font-size: 12px; color: var(--gold); }
  .ask { display: none; gap: 9px; padding-inline: 4px; margin-top: 11px; flex-wrap: wrap; }
  .ask[data-open="1"] { display: flex; animation: drop .24s ease; }
  @keyframes drop { from { opacity: 0; transform: translateY(-10px); } }
  .ask input {
    flex: 1; min-width: 130px; font-family: "IBM Plex Mono", monospace; font-size: 16px;
    text-transform: uppercase; color: var(--ink); background: var(--ground);
    border: 1px solid var(--line); border-radius: 3px; padding: 10px 12px;
  }
  .ask input:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; }
  .ask .go {
    font-family: inherit; font-size: 15px; color: var(--on-gold); background: var(--gold);
    border: none; border-radius: 3px; padding: 10px 22px; cursor: pointer;
  }
  .ask .err { flex-basis: 100%; font-size: 13px; color: var(--warn); margin: 0; }
  .ask .err:empty { display: none; }

  /* ---------- บล็อกเทียบร่างเก่า ---------- */
  .vs { margin: 24px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); }
  .vs h3 { font-family: Srisakdi, Sarabun, serif; font-weight: 700; font-size: 19px; margin: 0 0 3px; line-height: 1.4; }
  .vs .sub { margin: 0 0 14px; font-size: 13.5px; color: var(--ink-soft); }
  .vs ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .vs li { display: flex; align-items: baseline; gap: 10px; font-size: 14px; }
  .vs .nm2 { flex: 1; min-width: 0; color: var(--ink-faint); font-size: 13px; }
  .vs .mv { font-family: "IBM Plex Mono", monospace; font-size: 13.5px; flex: none; }
  .vs .tagx { font-size: 12.5px; flex: none; }
  .vs li[data-same="1"] .mv { color: var(--ink-faint); }
  .vs li[data-same="1"] .tagx { color: var(--ink-faint); }
  .vs li[data-same="0"] .mv { color: var(--c); font-weight: 600; }
  .vs li[data-same="0"] .tagx { color: var(--c); }
  .kept { margin: 16px 0 0; font-size: 13px; color: var(--ink-faint); line-height: 1.6; }

  /* ---------- จุดแข็ง/จุดระวัง/สายงาน/ประโยคเติบโต ---------- */
  .over {
    margin: 20px 0 0; padding-top: 18px; border-top: 1px solid var(--line);
    font-size: 15px; line-height: 1.85; color: var(--ink-soft);
  }
  .facts { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-direction: column; gap: 13px; }
  .facts li { display: flex; flex-direction: column; gap: 2px; }
  .fk { font-size: 11.5px; color: var(--ink-faint); letter-spacing: .01em; }
  .facts p { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--ink); }
  .grow {
    margin: 16px 0 0; padding: 13px 15px; font-size: 14.5px; line-height: 1.65;
    color: var(--ink); background: color-mix(in srgb, var(--gold) 10%, var(--surface));
    border-left: 3px solid var(--gold); border-radius: 0 3px 3px 0;
  }
  .grow:empty { display: none; }

  /* ---------- การ์ดทำเนียบแบบกดขยาย ---------- */
  /* ---------- ข้อ deep: ตัวเลือกยาวและไม่มีอิโมจิ ---------- */
  .opts[data-custom="1"] button { align-items: flex-start; gap: 10px; padding: 13px 15px; }
  .opts[data-custom="1"] .lab { line-height: 1.55; }
  .opts[data-custom="1"] .key { align-self: center; }

  .dexlink { display: flex; align-items: center; gap: 7px; margin: 4px auto 0; font-family: inherit; font-size: 14px; color: var(--ink-soft); background: none; border: none; cursor: pointer; }
  .dexlink span { text-decoration: underline; text-underline-offset: 4px; }
  .dexlink:hover { color: var(--gold); }
</style>

