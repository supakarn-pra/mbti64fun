<script is:inline define:vars={{ QUESTIONS: Q, AXES: A, CHOICES, TYPES: T, GUILDS: G, DRAW, DEPTHS, ARCHETYPES, ICONS }}>
  const KEY = "mbti64.v4";
  const $ = (id) => document.getElementById(id);
  const card = $("card"), optBox = $("opts"), result = $("result"), stage = $("stage"), start = $("start");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const guildOf = (b) => (b[1] === "N" ? (b[2] === "T" ? "NT" : "NF") : b[3] === "J" ? "SJ" : "SP");
  const UPGRADE_AXES = ["AT", "CS"];

  // S.mode: new | compare | upgrade, S.old: ผลเดิมที่กรอกไว้, S.ans: คำตอบ (key = index ใน QUESTIONS)
  let S = { mode: null, old: null, rush: false, home: false, ans: {} };
  try { Object.assign(S, JSON.parse(localStorage.getItem(KEY) || "{}")); } catch (e) {}
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) {} };

  let plan = [], at = 0;

  // รับได้ทั้ง ENFP / ENFP-T / ENFPTC / enfp-tc
  function parseType(raw) {
    const t = (raw || "").toUpperCase().replace(/[^A-Z]/g, "");
    if (!/^[EI][SN][TF][JP]/.test(t)) return null;
    const rest = t.slice(4);
    if (rest.length > 2) return null;
    if (rest[0] && !"AT".includes(rest[0])) return null;
    if (rest[1] && !"CS".includes(rest[1])) return null;
    return { base: t.slice(0, 4), AT: rest[0] || "", CS: rest[1] || "" };
  }

  // ข้อทั่วไปใช้ 4 ตัวเลือกมาตรฐาน ส่วนข้อ deep มีตัวเลือกเฉพาะของมันเอง เลยสร้างใหม่ทุกข้อ
  const optsOf = (q) =>
    q.choices ? q.choices.map(([label, value]) => ({ label, value, custom: true })) : CHOICES;

  function renderOpts(q) {
    const list = optsOf(q);
    optBox.dataset.custom = q.choices ? "1" : "0";
    optBox.innerHTML = "";
    list.forEach((c, k) => {
      const b = document.createElement("button");
      b.type = "button";
      b.dataset.side = c.side || (c.value > 0 ? "yes" : "no");
      b.dataset.strength = String(Math.abs(c.value));
      b.setAttribute("aria-pressed", "false");
      b.innerHTML = (c.custom ? "" : '<span class="emo" aria-hidden="true"></span>') +
        '<span class="lab"></span><span class="key">' + (k + 1) + "</span>";
      if (!c.custom) b.querySelector(".emo").textContent = c.icon;
      b.querySelector(".lab").textContent = c.label;
      b.onclick = () => answer(c.value);
      optBox.appendChild(b);
    });
  }

  /* ---------- หน้าเลือกโหมด ---------- */
  function openAsk(which) {
    ["compare", "upgrade"].forEach((m) => {
      const on = m === which;
      $("ask-" + m).dataset.open = on ? "1" : "0";
      $("m-" + m).setAttribute("aria-expanded", String(on));
    });
    if (which) $("in-" + which).focus();
  }
  let rush = false;
  const perAxis = (r) => Object.values(DRAW[r ? "rush" : "full"]).reduce((a, b) => a + b, 0);
  const counts = () => ({ full: perAxis(rush) * AXES.length, up: perAxis(rush) * UPGRADE_AXES.length });
  // ไล่เลขทีละขั้นตอนสลับโหมด 90 -> 89 -> ... -> 30
  function countTo(el, to, fmt) {
    const from = el._n === undefined ? to : el._n;
    el._n = to;
    cancelAnimationFrame(el._raf);
    if (reduce || from === to) { el.textContent = fmt(to); return; }
    // ไล่แบบเกือบเชิงเส้น จะได้เห็นเลขระหว่างทางครบ ๆ ไม่ใช่กระโดดไปค้างที่ปลายทาง
    const t0 = performance.now(), dur = 650;
    const step = (t) => {
      const k = Math.min(1, (t - t0) / dur);
      const e = k < .5 ? 1.15 * k : 1 - Math.pow(1 - k, 2) * .7;
      el.textContent = fmt(Math.round(from + (to - from) * Math.min(1, e)));
      if (k < 1) el._raf = requestAnimationFrame(step);
    };
    el._raf = requestAnimationFrame(step);
  }
  const nQ = (n) => n + " ข้อ";
  const nGo = (n) => "เริ่ม " + n + " ข้อ";
  function syncCounts() {
    const c = counts();
    countTo($("n-new"), c.full, nQ);
    countTo($("n-compare"), c.full, nQ);
    countTo($("n-upgrade"), c.up, nQ);
    countTo($("go-compare"), c.full, nGo);
    countTo($("go-upgrade"), c.up, nGo);
  }
  function paintLen() {
    start.dataset.rush = rush ? "1" : "0";
    document.querySelectorAll(".len button").forEach((x) =>
      x.setAttribute("aria-pressed", String((x.dataset.rush === "1") === rush)));
  }
  document.querySelectorAll(".len button").forEach((b) => {
    b.onclick = () => {
      rush = b.dataset.rush === "1";
      paintLen();
      syncCounts();
    };
  });
  paintLen();
  syncCounts();

  $("m-new").onclick = () => begin("new", null);
  $("m-compare").onclick = () => openAsk("compare");
  $("m-upgrade").onclick = () => openAsk("upgrade");

  ["compare", "upgrade"].forEach((m) => {
    const submit = () => {
      const old = parseType($("in-" + m).value);
      $("err-" + m).textContent = old ? "" : m === "upgrade"
        ? "พิมพ์ 4 ตัวแรกให้ถูกนะ เช่น ENFP (E/I · S/N · T/F · J/P)"
        : "พิมพ์แบบนี้นะ ENFP หรือ ENFP-T หรือ ENFP-TC";
      if (old) begin(m, m === "upgrade" ? { base: old.base, AT: "", CS: "" } : old);
    };
    $("go-" + m).onclick = submit;
    $("in-" + m).onkeydown = (e) => { if (e.key === "Enter") submit(); };
  });

  const sig = (o) => (o ? o.base + o.AT + o.CS : "");
  // สุ่มข้อจากคลัง: แต่ละแกนหยิบตามโควตาของแต่ละระดับ สลับทิศทาง + - ให้สมดุล แล้วค่อยสลับแกนวนกัน
  function drawPlan(axes, mix) {
    const shuffled = (arr) => arr.map((v) => [Math.random(), v]).sort((a, b) => a[0] - b[0]).map((x) => x[1]);
    const lanes = axes.map((axis) => {
      const picked = [];
      Object.entries(mix).forEach(([depth, n]) => {
        const bag = QUESTIONS.map((q, i) => ({ q, i })).filter((x) => x.q.axis === axis && x.q.depth === depth);
        const pos = shuffled(bag.filter((x) => x.q.dir > 0));
        const neg = shuffled(bag.filter((x) => x.q.dir < 0));
        for (let k = 0; k < n; k++) {
          const first = k % 2 === 0 ? pos : neg;
          const hit = first.pop() || (k % 2 === 0 ? neg : pos).pop();
          if (hit) picked.push(hit.i);
        }
      });
      return shuffled(picked);
    });
    // สลับแกนวนไปเรื่อย ๆ กันคนเดาว่ากำลังวัดอะไรอยู่ มอนสเตอร์ทั้งแถวจึงเลือดลดพร้อม ๆ กัน
    const out = [];
    for (let k = 0; ; k++) {
      const row = lanes.map((l) => l[k]).filter((x) => x !== undefined);
      if (!row.length) break;
      out.push(...shuffled(row));
    }
    return out;
  }

  function begin(mode, old) {
    const same = S.mode === mode && !!S.rush === rush && sig(S.old) === sig(old) && S.plan;
    const axes = mode === "upgrade" ? UPGRADE_AXES : AXES.map((x) => x.key);
    S = {
      mode, old, rush, home: false,
      plan: same ? S.plan : drawPlan(axes, DRAW[rush ? "rush" : "full"]),
      ans: same ? S.ans : {},
    };
    save();
    run();
  }

  // กลับบ้านแบบไม่ล้างคำตอบ กดโหมดเดิมเข้ามาใหม่จะทำต่อจากข้อที่ค้างไว้
  function home() {
    S.home = true;
    save();
    showResume();
    $("intro").hidden = false;
    stage.hidden = true;
    result.hidden = true;
    start.hidden = false;
    $("segs").hidden = false;
    $("intro").textContent = "แบบประเมินตำแหน่งประจำปี · ฝ่ายบุคคลแห่งอาณาจักร";
    scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
  }
  // ตอบไปแล้วเยอะ ๆ กดพลาดทีเดียวจะเสียใจ เลยถามก่อน
  $("home").onclick = () => {
    const done = plan.filter((i) => S.ans[i] !== undefined).length;
    if (!done) return home();
    $("leave-msg").textContent =
      "ตอบไปแล้ว " + done + " ข้อ คำตอบยังถูกเก็บไว้ ถ้ากลับเข้ามาด้วยโหมดและความยาวเดิมจะทำต่อจากข้อที่ค้างได้เลย";
    $("leave").showModal();
  };
  $("leave-stay").onclick = () => $("leave").close();
  $("leave-go").onclick = () => { $("leave").close(); home(); };
  $("leave").addEventListener("click", (e) => { if (e.target === $("leave")) $("leave").close(); });

  /* ---------- ทำแบบทดสอบ ---------- */
  // ปุ่มทำต่อ โผล่เฉพาะตอนมีแบบทดสอบค้างอยู่
  function showResume() {
    const b = $("resume");
    const live = S.mode && Array.isArray(S.plan) && S.plan.length && S.plan.every((i) => QUESTIONS[i]);
    b.hidden = !live;
    if (!live) return;
    const done = S.plan.filter((i) => S.ans[i] !== undefined).length;
    const fin = done === S.plan.length;
    const what = S.mode === "upgrade" ? "อัพเกรดร่าง " + S.old.base
      : S.mode === "compare" ? "เทียบกับร่างเก่า " + code(S.old)
      : "แบบทดสอบใหม่";
    $("resume-k").textContent = fin ? what + " · ทำครบแล้ว" : what + " · ตอบไปแล้ว " + done + " / " + S.plan.length + " ข้อ";
    $("resume-t").textContent = fin ? "ดูผลลัพธ์" : "ทำแบบทดสอบต่อ";
  }
  $("resume").onclick = () => { S.home = false; save(); run(); };

  function run() {
    S.home = false;
    rush = !!S.rush;
    paintLen();
    syncCounts();
    // ถ้าคลังคำถามถูกแก้จนหมายเลขข้อเพี้ยน ให้สุ่มใหม่แทนที่จะพัง
    const ok = Array.isArray(S.plan) && S.plan.length && S.plan.every((i) => QUESTIONS[i]);
    if (!ok) {
      S.plan = drawPlan(S.mode === "upgrade" ? UPGRADE_AXES : AXES.map((x) => x.key), DRAW[S.rush ? "rush" : "full"]);
      S.ans = {};
      save();
    }
    plan = S.plan;
    const live = new Set(plan.map((i) => QUESTIONS[i].axis));
    AXES.forEach((x) => { document.querySelector('.seg[data-axis="' + x.key + '"]').hidden = !live.has(x.key); });

    start.hidden = true;
    result.hidden = true;
    stage.hidden = false;
    $("segs").hidden = false;
    const tail = " · " + plan.length + " ข้อ" + (S.rush ? " (ฉบับรีบ)" : "");
    $("intro").textContent = (S.mode === "upgrade"
      ? "อัพเกรดร่าง " + S.old.base
      : S.mode === "compare"
        ? "เทียบกับร่างเก่า " + code(S.old)
        : "แบบประเมินตำแหน่งประจำปี") + tail;

    at = Math.max(0, plan.findIndex((i) => S.ans[i] === undefined));
    if (plan.every((i) => S.ans[i] !== undefined)) return show();
    draw(false);
  }

  const code = (o) => o.base + (o.AT ? "-" + o.AT + o.CS : "");

  function draw(animate) {
    const q = QUESTIONS[plan[at]];
    card.style.setProperty("--c", "var(--c-" + q.axis + ")");
    const d = DEPTHS[q.depth] || DEPTHS.surface;
    $("qnum").innerHTML = '<i class="dep"></i>ข้อ ' + String(at + 1).padStart(2, "0") + " / " + plan.length;
    const dep = $("qnum").querySelector(".dep");
    dep.style.background = d.color;
    dep.title = d.label;
    $("qtext").textContent = q.text;
    renderOpts(q);
    optBox.querySelectorAll("button").forEach((b, k) =>
      b.setAttribute("aria-pressed", String(optsOf(q)[k].value === S.ans[plan[at]])));
    $("back").disabled = at === 0;

    const left = plan.filter((i) => S.ans[i] === undefined).length;
    $("left").textContent = left ? "เหลืออีก " + left + " ข้อ" : "ตอบครบแล้ว";

    // แต่ละแกนคือมอนสเตอร์หนึ่งตัว ตอบครบแกนไหน = ล้มตัวนั้น
    AXES.forEach((x) => {
      const inPlan = plan.filter((i) => QUESTIONS[i].axis === x.key);
      if (!inPlan.length) return;
      const done = inPlan.filter((i) => S.ans[i] !== undefined).length;
      const dead = done === inPlan.length;
      const seg = document.querySelector('.seg[data-axis="' + x.key + '"]');
      seg.querySelector(".hp i").style.width = (done / inPlan.length) * 100 + "%";
      seg.dataset.live = q.axis === x.key ? "1" : "0";
      if (dead && seg.dataset.dead !== "1" && !reduce) {
        seg.classList.add("slay");
        setTimeout(() => seg.classList.remove("slay"), 600);
      }
      seg.dataset.dead = dead ? "1" : "0";
    });

    if (animate && !reduce) { card.classList.remove("turn"); void card.offsetWidth; card.classList.add("turn"); }
  }

  // ฟาดมอนสเตอร์ของแกนนี้ ดาเมจสุ่มสองหลักเฉย ๆ ไม่ผูกกับคำตอบ
  // ถ้าโชว์คะแนนจริงจะเดาได้ว่าตอบแบบไหนดันไปทางไหน แล้วจะกดล็อกผลกันได้
  function whack(axis) {
    if (reduce) return;
    const seg = document.querySelector('.seg[data-axis="' + axis + '"]');
    if (!seg || seg.dataset.dead === "1") return;
    seg.classList.add("hit");
    setTimeout(() => seg.classList.remove("hit"), 400);
    const n = document.createElement("span");
    n.className = "dmg";
    n.textContent = "-" + (10 + Math.floor(Math.random() * 90));
    seg.appendChild(n);
    setTimeout(() => n.remove(), 760);
  }

  function answer(v) {
    whack(QUESTIONS[plan[at]].axis);
    S.ans[plan[at]] = v;
    save();
    if (plan.every((i) => S.ans[i] !== undefined)) { draw(false); return show(); }
    const next = at + 1 < plan.length && S.ans[plan[at + 1]] === undefined
      ? at + 1
      : plan.findIndex((i) => S.ans[i] === undefined);
    at = next;
    draw(true);
  }

  $("back").onclick = () => { if (at > 0) { at--; draw(true); } };
  addEventListener("keydown", (e) => {
    if (stage.hidden) return;
    if (e.key >= "1" && e.key <= "4") {
      const c = optsOf(QUESTIONS[plan[at]])[+e.key - 1];
      if (c) answer(c.value);
    }
    if (e.key === "Backspace" || e.key === "ArrowLeft") $("back").click();
  });

  /* ---------- ผลลัพธ์ ---------- */
  let share = "";
  function show() {
    const measured = new Set(plan.map((i) => QUESTIONS[i].axis));
    const sum = {}, top = {};
    plan.forEach((i) => {
      const q = QUESTIONS[i], w = q.weight || 1;
      sum[q.axis] = (sum[q.axis] || 0) + q.dir * (S.ans[i] || 0) * w;
      top[q.axis] = (top[q.axis] || 0) + 2 * w; // คะแนนเต็มของแกนนี้ ใช้หารเป็นเปอร์เซ็นต์
    });

    // แกนที่ไม่ได้วัดในโหมดอัพเกรด ใช้ตัวอักษรจากร่างเดิม
    const oldLetters = S.old ? [S.old.base[0], S.old.base[1], S.old.base[2], S.old.base[3], S.old.AT, S.old.CS] : [];
    const letters = AXES.map((x, k) =>
      measured.has(x.key) ? (sum[x.key] >= 0 ? x.a : x.b) : oldLetters[k]);
    const base = letters.slice(0, 4).join("");
    const full = base + "-" + letters[4] + letters[5];
    const info = TYPES[full];
    const nick = info.name, tag = info.tag;
    const g = GUILDS[guildOf(base)];

    $("rpic").src = "mob/" + full + ".webp";
    $("rsigil").innerHTML = '<svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true">' + (ICONS[g.icon] || "") + "</svg>";
    $("rguild").textContent = g.name;
    $("rgline").textContent = g.line;
    $("rcode").textContent = full;
    $("rnick").textContent = nick;
    $("rtag").textContent = tag;
    $("r-over").textContent = info.over;
    $("r-good").textContent = info.good;
    $("r-care").textContent = info.care;
    $("r-roles").textContent = info.roles.join(" · ");
    $("r-grow").textContent = info.grow;
    $("rarchetype").textContent = "Archetype · " + (ARCHETYPES[base] || "");

    const kept = $("rkept");
    kept.hidden = S.mode !== "upgrade";
    if (S.mode === "upgrade")
      kept.textContent = "4 แกนแรกใช้จากร่างเดิมที่กรอกไว้ (" + S.old.base + ") วัดใหม่เฉพาะจิตใจกับความผูกพัน";

    // เทียบทีละตัวอักษร เฉพาะตัวที่เขากรอกมา
    const vs = $("rvs");
    vs.hidden = S.mode !== "compare";
    if (S.mode === "compare") {
      const ul = $("vs-list");
      ul.innerHTML = "";
      let changed = 0, checked = 0;
      AXES.forEach((x, k) => {
        const was = oldLetters[k];
        if (!was) return;
        checked++;
        const same = was === letters[k];
        if (!same) changed++;
        const li = document.createElement("li");
        li.dataset.same = same ? "1" : "0";
        li.style.setProperty("--c", "var(--c-" + x.key + ")");
        li.innerHTML = '<span class="nm2"></span><span class="mv">(' + was + ") → (" + letters[k] + ')</span><span class="tagx"></span>';
        li.querySelector(".nm2").textContent = x.name;
        li.querySelector(".tagx").textContent = same ? "เหมือนเดิม" : "เปลี่ยน";
        ul.appendChild(li);
      });
      $("vs-head").textContent = changed === 0 ? "ยังเป็นร่างเดิมทุกตัว" : "เปลี่ยนไป " + changed + " จาก " + checked + " ตัว";
      $("vs-sub").textContent = "ร่างเก่าที่กรอกไว้ " + code(S.old) + " · ร่างใหม่ " + full;
    }

    const ul = $("rstats");
    ul.querySelectorAll(".stat").forEach((n) => n.remove());
    AXES.forEach((x) => {
      if (!measured.has(x.key)) return;
      const first = sum[x.key] >= 0;
      const pct = Math.round(50 + (sum[x.key] / top[x.key]) * 50);
      const li = document.createElement("li");
      li.className = "stat";
      li.style.setProperty("--c", "var(--c-" + x.key + ")");
      li.innerHTML =
        '<span class="nm"></span>' +
        '<div class="pole" data-win="' + (first ? 1 : 0) + '"><span class="lt">(' + x.a + ')</span>' +
        '<span class="pl a"></span><span class="pc">' + pct + '%</span></div>' +
        '<div class="bar"><i></i></div>' +
        '<div class="pole" data-win="' + (first ? 0 : 1) + '"><span class="lt">(' + x.b + ')</span>' +
        '<span class="pl b"></span><span class="pc">' + (100 - pct) + '%</span></div><p></p>';
      li.querySelector(".nm").textContent = x.name;
      li.querySelector(".a").textContent = x.labA;
      li.querySelector(".b").textContent = x.labB;
      li.querySelector(".bar i").style.width = pct + "%";
      li.querySelector("p").textContent = first ? x.descA : x.descB;
      ul.appendChild(li);
    });

    share = ("ตำแหน่งของข้าในต่างโลก: " + nick + " (" + full + ")\n" + g.sigil + " " + g.name + " — " + tag +
      (S.mode === "compare" ? "\n(ร่างเก่า " + code(S.old) + ")" : "")).replace(/​/g, "");

    myCode = full;
    stage.hidden = true;
    start.hidden = true;
    result.hidden = false;
    $("segs").hidden = true;
    scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
  }

  $("again").onclick = () => {
    S = { mode: null, old: null, rush: false, home: false, ans: {} };
    save();
    openAsk(null);
    document.querySelectorAll(".seg").forEach((s2) => { s2.hidden = false; s2.querySelector("i").style.width = "0"; });
    home();
  };

  /* ---------- ทำเนียบ 64 ตำแหน่ง ---------- */
  let myCode = "";
  const GUILD_ORDER = ["SP", "SJ", "NF", "NT"];
  // พาธสัมพัทธ์ เผื่อหน้านี้ไม่ได้อยู่ที่ราก
  const goDex = () => { location.href = "dex/"; };
  $("dex-open").onclick = goDex;
  $("dex-open2").onclick = goDex;

  $("share").onclick = async (e) => {
    const b = e.currentTarget;
    const payload = { title: "64 ตำแหน่งในต่างโลก", text: share, url: location.href };
    if (navigator.share) {
      try { await navigator.share(payload); return; }
      catch (err) { if (err && err.name === "AbortError") return; } // ผู้ใช้กดปิดเอง ไม่ต้องทำอะไรต่อ
    }
    const lb = b.querySelector(".lb");
    try { await navigator.clipboard.writeText(share + "\n" + location.href); lb.textContent = "คัดลอกลิงก์แล้ว"; }
    catch (err) { lb.textContent = "แชร์ไม่ได้ ลองคัดลอกเอา"; }
    setTimeout(() => { lb.textContent = "แชร์ให้ผู้อื่น"; }, 2200);
  };

  $("copy").onclick = async (e) => {
    const b = e.currentTarget;
    const lb = b.querySelector(".lb");
    try { await navigator.clipboard.writeText(share); lb.textContent = "คัดลอกแล้ว"; }
    catch (err) { lb.textContent = "คัดลอกไม่ได้ ลองเลือกข้อความเอา"; }
    setTimeout(() => { lb.textContent = "คัดลอกไปแปะในแชท"; }, 2200);
  };

  if (S.mode && !S.home) run();
  else showResume();
</script>
