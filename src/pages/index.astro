---
import { AXES, QUESTIONS, CHOICES, TYPES, GUILDS, PER_AXIS } from "../data/quiz.js";

// เบราว์เซอร์บางตัว (webview ใน LINE/แอปต่าง ๆ) ไม่มีพจนานุกรมตัดคำไทย เลยตัดบรรทัดกลางคำ
// ตัดคำด้วย Intl.Segmenter ตอน build แล้วคั่นด้วย zero-width space ให้เบราว์เซอร์รู้ว่าตรงไหนตัดได้
const seg = new Intl.Segmenter("th", { granularity: "word" });
const th = (s) => [...seg.segment(s)].map((x) => x.segment).join("​");
const Q = QUESTIONS.map((q) => ({ ...q, text: th(q.text) }));
const T = Object.fromEntries(Object.entries(TYPES).map(([k, v]) => [k, v.map(th)]));
const A = AXES.map((x) => ({ ...x, labA: th(x.labA), labB: th(x.labB), descA: th(x.descA), descB: th(x.descB) }));
const G = Object.fromEntries(Object.entries(GUILDS).map(([k, v]) => [k, { ...v, line: th(v.line) }]));

const vars = (mode) =>
  AXES.map((x) => `--c-${x.key}:${x[mode]};`).join("") +
  Object.entries(GUILDS).map(([k, g]) => `--g-${k}:${g[mode]};`).join("");
const axisPalette = `
:root{${vars("light")}}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){${vars("dark")}}}
:root[data-theme="dark"]{${vars("dark")}}
`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- ต้องมี lang=th ไม่งั้นเบราว์เซอร์ตัดบรรทัดกลางคำไทย เช่น "ก / ลุ่ม" -->
<script is:inline>document.documentElement.lang = "th";</script>
<title>64 ตำแหน่งในต่างโลก</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Srisakdi:wght@400;700&family=Sarabun:wght@300;400;600;700&family=IBM+Plex+Mono:wght@500&display=swap"
/>

<style is:inline set:html={axisPalette}></style>

<style is:global>
  :root {
    --ground: #EBE7E0;
    --surface: #FBF9F6;
    --line: #D6CFC2;
    --ink: #24201C;
    --ink-soft: #625A50;
    --ink-faint: #8C8376;
    --gold: #8A6A15;
    --on-gold: #FFFCF4;
    --blood: #8E2C33;
    --warn: #A33C1E;
    --shadow: 0 1px 2px rgba(36, 32, 28, .06), 0 20px 44px -26px rgba(36, 32, 28, .5);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #14121B;
      --surface: #1D1A26;
      --line: #342F41;
      --ink: #F0EBE2;
      --ink-soft: #ADA598;
      --ink-faint: #7E7668;
      --gold: #D9B15A;
      --on-gold: #1A150A;
      --blood: #E58089;
      --warn: #F0956F;
      --shadow: 0 1px 2px rgba(0, 0, 0, .5), 0 20px 44px -26px rgba(0, 0, 0, .95);
    }
  }
  :root[data-theme="dark"] {
    --ground: #14121B;
    --surface: #1D1A26;
    --line: #342F41;
    --ink: #F0EBE2;
    --ink-soft: #ADA598;
    --ink-faint: #7E7668;
    --gold: #D9B15A;
    --on-gold: #1A150A;
    --blood: #E58089;
    --warn: #F0956F;
    --shadow: 0 1px 2px rgba(0, 0, 0, .5), 0 20px 44px -26px rgba(0, 0, 0, .95);
  }

  * { box-sizing: border-box; }
  /* ต้องมี ไม่งั้น hidden ไม่ชนะ display:flex ของ .start / .stage */
  [hidden] { display: none !important; }
  body {
    background: var(--ground);
    color: var(--ink);
    font-family: Sarabun, "Noto Sans Thai", "Leelawadee UI", Thonburi, system-ui, sans-serif;
    font-weight: 400;
    line-height: 1.75;
  }
  .wrap { max-width: 620px; margin: 0 auto; padding-inline: 20px; padding-block: 0 56px; }
  .fx { font-family: Srisakdi, Sarabun, serif; font-weight: 700; }

  /* ---------- แถบบน ---------- */
  .top {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: blur(10px);
    margin-inline: -20px; padding: 12px 20px 10px;
    border-bottom: 1px solid var(--line);
  }
  .brow { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mark { font-size: 19px; line-height: 1.4; letter-spacing: .01em; }
  .mark span { color: var(--gold); }
  .count {
    font-family: "IBM Plex Mono", monospace; font-size: 12px;
    color: var(--ink-faint); font-variant-numeric: tabular-nums; flex: none;
  }
  .segs { display: flex; gap: 5px; margin-top: 9px; }
  .seg { flex: 1; height: 5px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .seg i { display: block; height: 100%; width: 0; background: var(--sc); transition: width .3s ease; }
  .seg[data-live="1"] { background: color-mix(in srgb, var(--sc) 25%, var(--line)); }

  /* ---------- ใบประเมิน ---------- */
  .intro {
    margin: 22px 0 0; font-size: 13.5px; color: var(--ink-faint);
    display: flex; align-items: center; gap: 10px;
  }
  .intro::before, .intro::after { content: ""; height: 1px; background: var(--line); flex: 1; }
  .stage { padding-top: 18px; }
  .card {
    background: color-mix(in srgb, var(--c) 6%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--c) 30%, var(--line));
    border-radius: 4px; box-shadow: var(--shadow);
    padding: 28px 24px 24px; position: relative;
  }
  .card::before {
    content: ""; position: absolute; inset: 5px; border: 1px solid color-mix(in srgb, var(--c) 18%, transparent);
    border-radius: 2px; pointer-events: none;
  }
  .card.turn { animation: slip .28s ease; }
  @keyframes slip { from { opacity: 0; transform: translateY(10px); } }
  .qnum { font-size: 12.5px; letter-spacing: .04em; color: var(--c); margin: 0 0 12px; font-weight: 600; }
  .qtext { font-size: clamp(20px, 5vw, 25px); line-height: 1.6; font-weight: 400; margin: 0 0 24px; text-wrap: pretty; }
  .opts { display: flex; flex-direction: column; gap: 9px; }
  .opts button {
    display: flex; align-items: center; gap: 13px; width: 100%; text-align: left;
    font-family: inherit; font-size: 16px; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 3px; padding: 12px 15px; cursor: pointer;
    transition: border-color .15s, background .15s, transform .1s;
  }
  .opts button:hover { border-color: var(--c); transform: translateX(3px); }
  .opts button:focus-visible { outline: 2px solid var(--c); outline-offset: 2px; }
  .emo {
    flex: none; width: 34px; text-align: center; line-height: 1;
    filter: grayscale(.45); opacity: .8;
    transition: transform .18s ease, filter .18s, opacity .18s;
  }
  .opts button[data-strength="2"] .emo { font-size: 27px; }
  .opts button[data-strength="1"] .emo { font-size: 22px; }
  .opts button:hover .emo, .opts button:focus-visible .emo {
    filter: none; opacity: 1; animation: dook .45s ease-in-out infinite;
  }
  @keyframes dook {
    0%, 100% { transform: scale(1.3) rotate(-9deg); }
    50% { transform: scale(1.3) rotate(9deg); }
  }
  .opts button[aria-pressed="true"] { border-color: var(--c); background: color-mix(in srgb, var(--c) 13%, var(--surface)); }
  .opts button[aria-pressed="true"] .emo { filter: none; opacity: 1; transform: scale(1.2); }
  .key {
    margin-left: auto; font-family: "IBM Plex Mono", monospace; font-size: 11px; color: var(--ink-faint);
    border: 1px solid var(--line); border-radius: 3px; padding: 0 6px; flex: none;
  }
  @media (max-width: 430px) { .key { display: none; } }

  .under { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 16px; }
  .under .left { flex: 1; text-align: center; }
  .ghost { font-family: inherit; font-size: 14px; color: var(--ink-soft); background: none; border: none; cursor: pointer; padding: 6px 0; }
  .ghost:hover { color: var(--ink); }
  .ghost:disabled { opacity: .35; cursor: default; }
  .ghost:focus-visible { outline: 2px solid var(--ink-faint); outline-offset: 2px; }
  .left { font-size: 13px; color: var(--ink-faint); }

  /* ---------- บัตรประจำตัว ---------- */
  #result[hidden] { display: none; }
  .rcard {
    background: var(--surface); border: 1px solid var(--gold);
    border-radius: 4px; box-shadow: var(--shadow); padding: 30px 24px; position: relative;
  }
  .rcard::before {
    content: ""; position: absolute; inset: 5px;
    border: 1px solid color-mix(in srgb, var(--gold) 35%, transparent); border-radius: 2px; pointer-events: none;
  }
  /* ไม่ใส่ letter-spacing กับข้อความไทย สระกับวรรณยุกต์จะลอยห่างจากตัวอักษร */
  .issued { font-size: 12px; color: var(--ink-faint); margin: 0 0 18px; }
  .guild { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
  .sigil {
    width: 40px; height: 40px; flex: none; display: grid; place-items: center; font-size: 19px;
    color: var(--gold); border: 1px solid var(--gold); border-radius: 50%;
  }
  .gname { font-size: 17px; line-height: 1.3; }
  .gline { display: block; font-family: Sarabun, sans-serif; font-weight: 400; font-size: 12.5px; color: var(--ink-faint); line-height: 1.5; }
  .code { font-family: "IBM Plex Mono", monospace; font-size: 15px; letter-spacing: .22em; color: var(--gold); margin: 0; }
  .nick { font-size: clamp(27px, 7vw, 38px); line-height: 1.35; margin: 4px 0 10px; text-wrap: balance; }
  .tag { margin: 0; color: var(--ink-soft); font-size: 15.5px; }

  .stats { list-style: none; margin: 26px 0 0; padding: 20px 0 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 17px; }
  .stats .head { font-size: 12px; color: var(--ink-faint); margin: -4px 0 0; }
  .stat .nm { font-size: 12.5px; color: var(--ink-faint); display: block; margin-bottom: 4px; }
  .pole { display: flex; align-items: baseline; gap: 8px; font-size: 14.5px; line-height: 1.5; }
  .pole .lt { font-family: "IBM Plex Mono", monospace; font-size: 12px; flex: none; opacity: .75; }
  .pole .pl { flex: 1; min-width: 0; }
  .pole .pc { font-family: "IBM Plex Mono", monospace; font-variant-numeric: tabular-nums; flex: none; }
  .pole[data-win="1"] { color: var(--c); font-weight: 600; }
  .pole[data-win="0"] { color: var(--ink-faint); }
  .bar { height: 7px; border-radius: 4px; background: var(--line); margin: 5px 0; position: relative; overflow: hidden; }
  .bar i { position: absolute; top: 0; bottom: 0; left: 0; background: var(--c); }
  .stat p { margin: 6px 0 0; font-size: 13.5px; color: var(--ink-soft); line-height: 1.6; }

  .tools { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .tools button { font-family: inherit; font-size: 14px; color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: 3px; padding: 9px 18px; cursor: pointer; }
  .tools button:hover { border-color: var(--gold); }
  .tools button:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

  footer { margin-top: 32px; font-size: 12.5px; color: var(--ink-faint); line-height: 1.7; text-align: center; }
  @media (prefers-reduced-motion: reduce) { *, *::before { animation: none !important; transition: none !important; } }

  /* ---------- หน้าเลือกโหมด ---------- */
  .start { display: flex; flex-direction: column; gap: 14px; padding-top: 18px; }
  .len { display: flex; gap: 8px; }
  .len button {
    flex: 1; font-family: inherit; font-size: 14.5px; color: var(--ink-soft);
    background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
    padding: 9px 14px; cursor: pointer; transition: border-color .15s, color .15s;
  }
  .len button i { font-style: normal; font-family: "IBM Plex Mono", monospace; font-size: 12px; opacity: .7; font-variant-numeric: tabular-nums; }
  .len button[data-rush="0"] { --t: var(--gold); }
  .len button[data-rush="1"] { --t: var(--blood); }
  .len button:hover { border-color: var(--t); }
  .len button[aria-pressed="true"] { border-color: var(--t); color: var(--t); font-weight: 600; background: color-mix(in srgb, var(--t) 8%, var(--surface)); }
  .len button:focus-visible { outline: 2px solid var(--t); outline-offset: 2px; }
  /* เลือกฉบับรีบแล้ว ให้ทั้งหน้าแรกเปลี่ยนเป็นโทนแดงเลือดหมู */
  .start[data-rush="1"] { --gold: var(--blood); --on-gold: #FFF4F2; }
  .mode {
    display: block; width: 100%; text-align: left; font-family: inherit; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line); border-radius: 4px;
    padding: 18px 20px; cursor: pointer; transition: border-color .15s, transform .1s;
  }
  .mode:hover { border-color: var(--gold); transform: translateY(-2px); }
  .mode:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .mode[aria-expanded="true"] { border-color: var(--gold); }
  .mode b { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-family: Srisakdi, Sarabun, serif; font-weight: 700; font-size: 21px; line-height: 1.4; }
  .mode b em { flex: none; font-variant-numeric: tabular-nums; }
  .ask .go { font-variant-numeric: tabular-nums; }
  .mode span { display: block; font-size: 13.5px; color: var(--ink-soft); line-height: 1.6; margin-top: 3px; }
  .mode em { font-style: normal; font-family: "IBM Plex Mono", monospace; font-size: 12px; color: var(--gold); }
  .ask { display: none; gap: 9px; padding-inline: 4px; margin-top: 11px; flex-wrap: wrap; }
  .ask[data-open="1"] { display: flex; animation: drop .24s ease; }
  @keyframes drop { from { opacity: 0; transform: translateY(-10px); } }
  .ask input {
    flex: 1; min-width: 130px; font-family: "IBM Plex Mono", monospace; font-size: 16px;
    text-transform: uppercase; color: var(--ink); background: var(--ground);
    border: 1px solid var(--line); border-radius: 3px; padding: 10px 12px;
  }
  .ask input:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; }
  .ask .go {
    font-family: inherit; font-size: 15px; color: var(--on-gold); background: var(--gold);
    border: none; border-radius: 3px; padding: 10px 22px; cursor: pointer;
  }
  .ask .err { flex-basis: 100%; font-size: 13px; color: var(--warn); margin: 0; }
  .ask .err:empty { display: none; }

  /* ---------- บล็อกเทียบร่างเก่า ---------- */
  .vs { margin: 24px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); }
  .vs h3 { font-family: Srisakdi, Sarabun, serif; font-weight: 700; font-size: 19px; margin: 0 0 3px; line-height: 1.4; }
  .vs .sub { margin: 0 0 14px; font-size: 13.5px; color: var(--ink-soft); }
  .vs ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .vs li { display: flex; align-items: baseline; gap: 10px; font-size: 14px; }
  .vs .nm2 { flex: 1; min-width: 0; color: var(--ink-faint); font-size: 13px; }
  .vs .mv { font-family: "IBM Plex Mono", monospace; font-size: 13.5px; flex: none; }
  .vs .tagx { font-size: 12.5px; flex: none; }
  .vs li[data-same="1"] .mv { color: var(--ink-faint); }
  .vs li[data-same="1"] .tagx { color: var(--ink-faint); }
  .vs li[data-same="0"] .mv { color: var(--c); font-weight: 600; }
  .vs li[data-same="0"] .tagx { color: var(--c); }
  .kept { margin: 16px 0 0; font-size: 13px; color: var(--ink-faint); line-height: 1.6; }

  /* ---------- ทำเนียบ 64 ตำแหน่ง ---------- */
  .dexlink { display: block; margin: 4px auto 0; font-family: inherit; font-size: 14px; color: var(--ink-soft); background: none; border: none; cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }
  .dexlink:hover { color: var(--gold); }
  .dexbar { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 2px; }
  .dexbar h2 { font-family: Srisakdi, Sarabun, serif; font-weight: 700; font-size: clamp(24px, 6vw, 32px); margin: 0; line-height: 1.35; }
  .dexsub { margin: 0 0 6px; font-size: 13.5px; color: var(--ink-faint); }

  .dexsec { margin-top: 30px; }
  .gh {
    display: flex; align-items: center; gap: 11px; margin: 0 0 12px; padding: 11px 14px;
    border: 1px solid color-mix(in srgb, var(--g) 40%, var(--line));
    border-left: 4px solid var(--g);
    border-radius: 3px; background: color-mix(in srgb, var(--g) 9%, var(--surface));
  }
  .gh .sg {
    width: 30px; height: 30px; flex: none; display: grid; place-items: center; font-size: 15px;
    color: var(--on-g); background: var(--g); border-radius: 50%; font-family: Sarabun, sans-serif;
  }
  .gh .gn { font-family: Srisakdi, Sarabun, serif; font-weight: 700; font-size: 19px; line-height: 1.35; color: var(--g); }
  .gh .gl { display: block; font-family: Sarabun, sans-serif; font-weight: 400; font-size: 12px; color: var(--ink-faint); line-height: 1.5; }
  .gh em { font-style: normal; font-family: "IBM Plex Mono", monospace; font-size: 11px; color: var(--ink-faint); margin-left: auto; flex: none; align-self: flex-start; }

  .dexlist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 10px; }
  .dexlist li {
    background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--g);
    border-radius: 3px; padding: 13px 14px 12px; display: flex; flex-direction: column;
  }
  .dexlist li[data-me="1"] { border-color: var(--g); box-shadow: 0 0 0 2px color-mix(in srgb, var(--g) 22%, transparent); }
  .crow { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; }
  .crow .av {
    width: 26px; height: 26px; flex: none; display: grid; place-items: center; font-size: 13px;
    color: var(--g); border: 1px solid color-mix(in srgb, var(--g) 50%, var(--line)); border-radius: 50%;
  }
  .crow .dc { font-family: "IBM Plex Mono", monospace; font-size: 11.5px; letter-spacing: .12em; color: var(--g); }
  .dexlist .dn { font-family: Srisakdi, Sarabun, serif; font-weight: 700; font-size: 16.5px; line-height: 1.45; margin-bottom: 4px; }
  .dexlist .dt { font-size: 12.5px; color: var(--ink-soft); line-height: 1.55; }
  .chips { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; padding-top: 9px; border-top: 1px dashed var(--line); }
  .chips span {
    font-size: 11px; line-height: 1.7; color: var(--ink-faint);
    border: 1px solid var(--line); border-radius: 999px; padding: 0 8px;
  }
  .dexlist li[data-me="1"] .me {
    align-self: flex-start; font-size: 11px; color: var(--on-g); background: var(--g);
    border-radius: 999px; padding: 1px 9px; margin-top: 10px;
  }
</style>

<div class="wrap">
  <div class="top">
    <div class="brow">
      <span class="mark fx">64 ตำแหน่งใน<span>ต่างโลก</span></span>
      <span class="count" id="count"></span>
    </div>
    <div class="segs" id="segs">
      {AXES.map((x) => (
        <div class="seg" style={`--sc:var(--c-${x.key})`} data-axis={x.key} title={x.name}><i></i></div>
      ))}
    </div>
  </div>

  <p class="intro" id="intro">{th("แบบประเมินตำแหน่งประจำปี · ฝ่ายบุคคลแห่งอาณาจักร")}</p>

  <section class="start" id="start">
    <div class="len" role="group" aria-label="ความยาวแบบทดสอบ">
      <button data-rush="0" aria-pressed="true">เต็มยศ <i>90</i></button>
      <button data-rush="1" aria-pressed="false">รีบไปทำงาน <i>30</i></button>
    </div>
    <div>
      <button class="mode" id="m-new" aria-expanded="false">
        <b>แบบทดสอบใหม่<em id="n-new"></em></b>
        <span>{th("วัดใหม่ทั้ง 6 แกน ได้ตำแหน่งแบบเต็ม ๆ")}</span>
      </button>
    </div>
    <div>
      <button class="mode" id="m-compare" aria-expanded="false">
        <b>เทียบกับร่างเก่า<em id="n-compare"></em></b>
        <span>{th("กรอกผลที่เคยได้ แล้วทำแบบทดสอบ ดูว่ายังเป็นคนเดิมอยู่ไหม")} <em>ENFP · ENFP-T · ENFP-TC</em></span>
      </button>
      <div class="ask" id="ask-compare">
        <input id="in-compare" maxlength="9" placeholder="ENFP-TC" autocomplete="off" spellcheck="false" aria-label="ผลที่เคยได้" />
        <button class="go" id="go-compare">เริ่ม 90 ข้อ</button>
        <p class="err" id="err-compare"></p>
      </div>
    </div>
    <div>
      <button class="mode" id="m-upgrade" aria-expanded="false">
        <b>อัพเกรดร่างเดิม<em id="n-upgrade"></em></b>
        <span>{th("กรอก 4 ตัวแรกที่เคยได้ วัดเพิ่มเฉพาะจิตใจ (A/T) กับความผูกพัน (C/S)")} <em>ENFP</em></span>
      </button>
      <div class="ask" id="ask-upgrade">
        <input id="in-upgrade" maxlength="9" placeholder="ENFP" autocomplete="off" spellcheck="false" aria-label="สี่ตัวอักษรเดิม" />
        <button class="go" id="go-upgrade">เริ่ม 30 ข้อ</button>
        <p class="err" id="err-upgrade"></p>
      </div>
    </div>
    <button class="dexlink" id="dex-open">ดูทั้ง 64 ตำแหน่ง</button>
  </section>

  <section id="dex" hidden>
    <div class="dexbar">
      <h2 class="fx">ทำเนียบ 64 ตำแหน่ง</h2>
      <button class="ghost" id="dex-close">← กลับ</button>
    </div>
    <p class="dexsub">{th("ทะเบียนพนักงานทั้งอาณาจักร แบ่งตาม 4 สังกัด สังกัดละ 16 ตำแหน่ง")}</p>
    <div id="dex-body"></div>
  </section>

  <div class="stage" id="stage" hidden>
    <section class="card" id="card">
      <p class="qnum" id="qnum"></p>
      <h1 class="qtext" id="qtext">{Q[0].text}</h1>
      <div class="opts" id="opts"></div>
    </section>
    <div class="under">
      <button class="ghost" id="back" disabled>← ย้อนกลับ</button>
      <span class="left" id="left"></span>
      <button class="ghost" id="home">กลับบ้าน</button>
    </div>
  </div>

  <section id="result" hidden aria-live="polite">
    <div class="rcard">
      <p class="issued">บัตรประจำตัวพนักงานแห่งอาณาจักร</p>
      <div class="guild">
        <span class="sigil" id="rsigil"></span>
        <span>
          <span class="gname fx" id="rguild"></span>
          <span class="gline" id="rgline"></span>
        </span>
      </div>
      <p class="code" id="rcode"></p>
      <h2 class="nick fx" id="rnick"></h2>
      <p class="tag" id="rtag"></p>
      <p class="kept" id="rkept" hidden></p>
      <div class="vs" id="rvs" hidden>
        <h3 class="fx" id="vs-head"></h3>
        <p class="sub" id="vs-sub"></p>
        <ul id="vs-list"></ul>
      </div>
      <ul class="stats" id="rstats"><li class="head">ค่าสถานะ</li></ul>
      <div class="tools">
        <button id="copy">คัดลอกไปแปะในแชท</button>
        <button id="again">ประเมินใหม่</button>
        <button id="share">แชร์ให้ผู้อื่น</button>
        <button id="dex-open2">ดูทั้ง 64 ตำแหน่ง</button>
      </div>
    </div>
  </section>

  <footer>
    {th("ทำขึ้นเพื่อความสนุกในทีม ไม่ใช่เครื่องมือวัดผลทางจิตวิทยา")}<br />
    {th("ห้ามใช้ตัดสินใจเรื่องการจ้างงานหรือประเมินผลคนจริง ๆ นะ")}
  </footer>
</div>

<script is:inline define:vars={{ QUESTIONS: Q, AXES: A, CHOICES, TYPES: T, GUILDS: G, PER_AXIS }}>
  const KEY = "mbti64.v4";
  const $ = (id) => document.getElementById(id);
  const card = $("card"), optBox = $("opts"), result = $("result"), stage = $("stage"), start = $("start");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const guildOf = (b) => (b[1] === "N" ? (b[2] === "T" ? "NT" : "NF") : b[3] === "J" ? "SJ" : "SP");
  const UPGRADE_AXES = ["AT", "CS"];

  // S.mode: new | compare | upgrade, S.old: ผลเดิมที่กรอกไว้, S.ans: คำตอบ (key = index ใน QUESTIONS)
  let S = { mode: null, old: null, rush: false, ans: {} };
  try { Object.assign(S, JSON.parse(localStorage.getItem(KEY) || "{}")); } catch (e) {}
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) {} };

  let plan = [], at = 0;

  // รับได้ทั้ง ENFP / ENFP-T / ENFPTC / enfp-tc
  function parseType(raw) {
    const t = (raw || "").toUpperCase().replace(/[^A-Z]/g, "");
    if (!/^[EI][SN][TF][JP]/.test(t)) return null;
    const rest = t.slice(4);
    if (rest.length > 2) return null;
    if (rest[0] && !"AT".includes(rest[0])) return null;
    if (rest[1] && !"CS".includes(rest[1])) return null;
    return { base: t.slice(0, 4), AT: rest[0] || "", CS: rest[1] || "" };
  }

  CHOICES.forEach((c, k) => {
    const b = document.createElement("button");
    b.type = "button";
    b.dataset.side = c.side;
    b.dataset.strength = String(Math.abs(c.value));
    b.setAttribute("aria-pressed", "false");
    b.innerHTML = '<span class="emo" aria-hidden="true"></span><span class="lab"></span><span class="key">' + (k + 1) + "</span>";
    b.querySelector(".emo").textContent = c.icon;
    b.querySelector(".lab").textContent = c.label;
    b.onclick = () => answer(c.value);
    optBox.appendChild(b);
  });

  /* ---------- หน้าเลือกโหมด ---------- */
  function openAsk(which) {
    ["compare", "upgrade"].forEach((m) => {
      const on = m === which;
      $("ask-" + m).dataset.open = on ? "1" : "0";
      $("m-" + m).setAttribute("aria-expanded", String(on));
    });
    if (which) $("in-" + which).focus();
  }
  // ฉบับรีบ: หยิบข้อที่ 1, 4, 7, 10, 13 ของแต่ละแกน (แกนละ 5 ข้อ) ยังได้ทั้งสองทิศทางครบ
  let rush = false;
  const counts = () => ({ full: rush ? 30 : 90, up: rush ? 10 : 30 });
  // ไล่เลขทีละขั้นตอนสลับโหมด 90 -> 89 -> ... -> 30
  function countTo(el, to, fmt) {
    const from = el._n === undefined ? to : el._n;
    el._n = to;
    cancelAnimationFrame(el._raf);
    if (reduce || from === to) { el.textContent = fmt(to); return; }
    // ไล่แบบเกือบเชิงเส้น จะได้เห็นเลขระหว่างทางครบ ๆ ไม่ใช่กระโดดไปค้างที่ปลายทาง
    const t0 = performance.now(), dur = 650;
    const step = (t) => {
      const k = Math.min(1, (t - t0) / dur);
      const e = k < .5 ? 1.15 * k : 1 - Math.pow(1 - k, 2) * .7;
      el.textContent = fmt(Math.round(from + (to - from) * Math.min(1, e)));
      if (k < 1) el._raf = requestAnimationFrame(step);
    };
    el._raf = requestAnimationFrame(step);
  }
  const nQ = (n) => n + " ข้อ";
  const nGo = (n) => "เริ่ม " + n + " ข้อ";
  function syncCounts() {
    const c = counts();
    countTo($("n-new"), c.full, nQ);
    countTo($("n-compare"), c.full, nQ);
    countTo($("n-upgrade"), c.up, nQ);
    countTo($("go-compare"), c.full, nGo);
    countTo($("go-upgrade"), c.up, nGo);
  }
  function paintLen() {
    start.dataset.rush = rush ? "1" : "0";
    document.querySelectorAll(".len button").forEach((x) =>
      x.setAttribute("aria-pressed", String((x.dataset.rush === "1") === rush)));
  }
  document.querySelectorAll(".len button").forEach((b) => {
    b.onclick = () => {
      rush = b.dataset.rush === "1";
      paintLen();
      syncCounts();
    };
  });
  paintLen();
  syncCounts();

  $("m-new").onclick = () => begin("new", null);
  $("m-compare").onclick = () => openAsk("compare");
  $("m-upgrade").onclick = () => openAsk("upgrade");

  ["compare", "upgrade"].forEach((m) => {
    const submit = () => {
      const old = parseType($("in-" + m).value);
      $("err-" + m).textContent = old ? "" : m === "upgrade"
        ? "พิมพ์ 4 ตัวแรกให้ถูกนะ เช่น ENFP (E/I · S/N · T/F · J/P)"
        : "พิมพ์แบบนี้นะ ENFP หรือ ENFP-T หรือ ENFP-TC";
      if (old) begin(m, m === "upgrade" ? { base: old.base, AT: "", CS: "" } : old);
    };
    $("go-" + m).onclick = submit;
    $("in-" + m).onkeydown = (e) => { if (e.key === "Enter") submit(); };
  });

  const sig = (o) => (o ? o.base + o.AT + o.CS : "");
  function begin(mode, old) {
    const same = S.mode === mode && !!S.rush === rush && sig(S.old) === sig(old);
    S = { mode, old, rush, ans: same ? S.ans : {} };
    save();
    run();
  }

  // กลับบ้านแบบไม่ล้างคำตอบ กดโหมดเดิมเข้ามาใหม่จะทำต่อจากข้อที่ค้างไว้
  function home() {
    $("intro").hidden = false;
    stage.hidden = true;
    result.hidden = true;
    $("dex").hidden = true;
    start.hidden = false;
    $("segs").hidden = false;
    $("count").textContent = "";
    $("intro").textContent = "แบบประเมินตำแหน่งประจำปี · ฝ่ายบุคคลแห่งอาณาจักร";
    scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
  }
  $("home").onclick = home;

  /* ---------- ทำแบบทดสอบ ---------- */
  function run() {
    rush = !!S.rush;
    paintLen();
    syncCounts();
    plan = QUESTIONS.map((q, i) => i).filter((i) =>
      (S.mode === "upgrade" ? UPGRADE_AXES.includes(QUESTIONS[i].axis) : true) &&
      (S.rush ? Math.floor(i / AXES.length) % 3 === 0 : true));
    const live = new Set(plan.map((i) => QUESTIONS[i].axis));
    AXES.forEach((x) => { document.querySelector('.seg[data-axis="' + x.key + '"]').hidden = !live.has(x.key); });

    start.hidden = true;
    result.hidden = true;
    stage.hidden = false;
    $("segs").hidden = false;
    const tail = " · " + plan.length + " ข้อ" + (S.rush ? " (ฉบับรีบ)" : "");
    $("intro").textContent = (S.mode === "upgrade"
      ? "อัพเกรดร่าง " + S.old.base
      : S.mode === "compare"
        ? "เทียบกับร่างเก่า " + code(S.old)
        : "แบบประเมินตำแหน่งประจำปี") + tail;

    at = Math.max(0, plan.findIndex((i) => S.ans[i] === undefined));
    if (plan.every((i) => S.ans[i] !== undefined)) return show();
    draw(false);
  }

  const code = (o) => o.base + (o.AT ? "-" + o.AT + o.CS : "");

  function draw(animate) {
    const q = QUESTIONS[plan[at]];
    card.style.setProperty("--c", "var(--c-" + q.axis + ")");
    $("qnum").textContent = "ข้อ " + String(at + 1).padStart(2, "0") + " / " + plan.length;
    $("qtext").textContent = q.text;
    optBox.querySelectorAll("button").forEach((b, k) =>
      b.setAttribute("aria-pressed", String(CHOICES[k].value === S.ans[plan[at]])));
    $("back").disabled = at === 0;
    $("count").textContent = String(at + 1).padStart(2, "0") + " / " + plan.length;

    const left = plan.filter((i) => S.ans[i] === undefined).length;
    $("left").textContent = left ? "เหลืออีก " + left + " ข้อ" : "ตอบครบแล้ว";

    AXES.forEach((x) => {
      const inPlan = plan.filter((i) => QUESTIONS[i].axis === x.key);
      const done = inPlan.filter((i) => S.ans[i] !== undefined).length;
      const seg = document.querySelector('.seg[data-axis="' + x.key + '"]');
      seg.querySelector("i").style.width = (inPlan.length ? done / inPlan.length : 0) * 100 + "%";
      seg.dataset.live = q.axis === x.key ? "1" : "0";
    });

    if (animate && !reduce) { card.classList.remove("turn"); void card.offsetWidth; card.classList.add("turn"); }
  }

  function answer(v) {
    S.ans[plan[at]] = v;
    save();
    if (plan.every((i) => S.ans[i] !== undefined)) { draw(false); return show(); }
    const next = at + 1 < plan.length && S.ans[plan[at + 1]] === undefined
      ? at + 1
      : plan.findIndex((i) => S.ans[i] === undefined);
    at = next;
    draw(true);
  }

  $("back").onclick = () => { if (at > 0) { at--; draw(true); } };
  addEventListener("keydown", (e) => {
    if (stage.hidden) return;
    if (e.key >= "1" && e.key <= "4") answer(CHOICES[+e.key - 1].value);
    if (e.key === "Backspace" || e.key === "ArrowLeft") $("back").click();
  });

  /* ---------- ผลลัพธ์ ---------- */
  let share = "";
  function show() {
    const measured = new Set(plan.map((i) => QUESTIONS[i].axis));
    const sum = {};
    plan.forEach((i) => { const q = QUESTIONS[i]; sum[q.axis] = (sum[q.axis] || 0) + q.dir * (S.ans[i] || 0); });

    // แกนที่ไม่ได้วัดในโหมดอัพเกรด ใช้ตัวอักษรจากร่างเดิม
    const oldLetters = S.old ? [S.old.base[0], S.old.base[1], S.old.base[2], S.old.base[3], S.old.AT, S.old.CS] : [];
    const letters = AXES.map((x, k) =>
      measured.has(x.key) ? (sum[x.key] >= 0 ? x.a : x.b) : oldLetters[k]);
    const base = letters.slice(0, 4).join("");
    const full = base + "-" + letters[4] + letters[5];
    const [nick, tag] = TYPES[full];
    const g = GUILDS[guildOf(base)];

    $("rsigil").textContent = g.sigil;
    $("rguild").textContent = g.name;
    $("rgline").textContent = g.line;
    $("rcode").textContent = full;
    $("rnick").textContent = nick;
    $("rtag").textContent = tag;

    const kept = $("rkept");
    kept.hidden = S.mode !== "upgrade";
    if (S.mode === "upgrade")
      kept.textContent = "4 แกนแรกใช้จากร่างเดิมที่กรอกไว้ (" + S.old.base + ") วัดใหม่เฉพาะจิตใจกับความผูกพัน";

    // เทียบทีละตัวอักษร เฉพาะตัวที่เขากรอกมา
    const vs = $("rvs");
    vs.hidden = S.mode !== "compare";
    if (S.mode === "compare") {
      const ul = $("vs-list");
      ul.innerHTML = "";
      let changed = 0, checked = 0;
      AXES.forEach((x, k) => {
        const was = oldLetters[k];
        if (!was) return;
        checked++;
        const same = was === letters[k];
        if (!same) changed++;
        const li = document.createElement("li");
        li.dataset.same = same ? "1" : "0";
        li.style.setProperty("--c", "var(--c-" + x.key + ")");
        li.innerHTML = '<span class="nm2"></span><span class="mv">(' + was + ") → (" + letters[k] + ')</span><span class="tagx"></span>';
        li.querySelector(".nm2").textContent = x.name;
        li.querySelector(".tagx").textContent = same ? "เหมือนเดิม" : "เปลี่ยน";
        ul.appendChild(li);
      });
      $("vs-head").textContent = changed === 0 ? "ยังเป็นร่างเดิมทุกตัว" : "เปลี่ยนไป " + changed + " จาก " + checked + " ตัว";
      $("vs-sub").textContent = "ร่างเก่าที่กรอกไว้ " + code(S.old) + " · ร่างใหม่ " + full;
    }

    const ul = $("rstats");
    ul.querySelectorAll(".stat").forEach((n) => n.remove());
    AXES.forEach((x) => {
      if (!measured.has(x.key)) return;
      const first = sum[x.key] >= 0;
      const per = plan.filter((i) => QUESTIONS[i].axis === x.key).length;
      const pct = Math.round(50 + (sum[x.key] / (per * 2)) * 50);
      const li = document.createElement("li");
      li.className = "stat";
      li.style.setProperty("--c", "var(--c-" + x.key + ")");
      li.innerHTML =
        '<span class="nm"></span>' +
        '<div class="pole" data-win="' + (first ? 1 : 0) + '"><span class="lt">(' + x.a + ')</span>' +
        '<span class="pl a"></span><span class="pc">' + pct + '%</span></div>' +
        '<div class="bar"><i></i></div>' +
        '<div class="pole" data-win="' + (first ? 0 : 1) + '"><span class="lt">(' + x.b + ')</span>' +
        '<span class="pl b"></span><span class="pc">' + (100 - pct) + '%</span></div><p></p>';
      li.querySelector(".nm").textContent = x.name;
      li.querySelector(".a").textContent = x.labA;
      li.querySelector(".b").textContent = x.labB;
      li.querySelector(".bar i").style.width = pct + "%";
      li.querySelector("p").textContent = first ? x.descA : x.descB;
      ul.appendChild(li);
    });

    share = ("ตำแหน่งของข้าในต่างโลก: " + nick + " (" + full + ")\n" + g.sigil + " " + g.name + " — " + tag +
      (S.mode === "compare" ? "\n(ร่างเก่า " + code(S.old) + ")" : "")).replace(/​/g, "");

    myCode = full;
    stage.hidden = true;
    start.hidden = true;
    result.hidden = false;
    $("segs").hidden = true;
    $("count").textContent = "";
    scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
  }

  $("again").onclick = () => {
    S = { mode: null, old: null, rush: false, ans: {} };
    save();
    openAsk(null);
    document.querySelectorAll(".seg").forEach((s2) => { s2.hidden = false; s2.querySelector("i").style.width = "0"; });
    home();
  };

  /* ---------- ทำเนียบ 64 ตำแหน่ง ---------- */
  let myCode = "";
  const GUILD_ORDER = ["SP", "SJ", "NF", "NT"];
  // ป้ายนิสัยสองแกนลึกจากตัวอักษรท้ายรหัส เช่น -AC = นิ่ง มั่นใจ + ทำงานกับทีม
  const deepLabel = (k, letter) => (AXES[k].a === letter ? AXES[k].labA : AXES[k].labB);

  function buildDex() {
    const body = $("dex-body");
    if (body.childElementCount) return;
    GUILD_ORDER.forEach((key) => {
      const g = GUILDS[key];
      const sec = document.createElement("section");
      sec.className = "dexsec";
      sec.style.setProperty("--g", "var(--g-" + key + ")");
      sec.style.setProperty("--on-g", "var(--surface)");

      const h = document.createElement("div");
      h.className = "gh";
      h.innerHTML = '<span class="sg"></span><span><span class="gn"></span><span class="gl"></span></span><em>16 ตำแหน่ง</em>';
      h.querySelector(".sg").textContent = g.sigil;
      h.querySelector(".gn").textContent = g.name;
      h.querySelector(".gl").textContent = g.line;

      const ul = document.createElement("ul");
      ul.className = "dexlist";
      Object.keys(TYPES).filter((c) => guildOf(c.slice(0, 4)) === key).forEach((c) => {
        const [nick, tag] = TYPES[c];
        const li = document.createElement("li");
        li.dataset.code = c;
        li.innerHTML =
          '<div class="crow"><span class="av"></span><span class="dc"></span></div>' +
          '<span class="dn"></span><span class="dt"></span>' +
          '<div class="chips"><span class="c1"></span><span class="c2"></span></div>';
        li.querySelector(".av").textContent = g.sigil;
        li.querySelector(".dc").textContent = c;
        li.querySelector(".dn").textContent = nick;
        li.querySelector(".dt").textContent = tag;
        li.querySelector(".c1").textContent = deepLabel(4, c[5]);
        li.querySelector(".c2").textContent = deepLabel(5, c[6]);
        ul.appendChild(li);
      });
      sec.append(h, ul);
      body.appendChild(sec);
    });
  }
  function openDex() {
    buildDex();
    $("dex-body").querySelectorAll("li").forEach((li) => {
      const me = li.dataset.code === myCode;
      li.dataset.me = me ? "1" : "0";
      const old = li.querySelector(".me");
      if (me && !old) { const b = document.createElement("span"); b.className = "me"; b.textContent = "ตำแหน่งของคุณ"; li.appendChild(b); }
      if (!me && old) old.remove();
    });
    start.hidden = true;
    stage.hidden = true;
    result.hidden = true;
    $("segs").hidden = true;
    $("intro").hidden = true;
    $("dex").hidden = false;
    scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
  }
  $("dex-open").onclick = openDex;
  $("dex-open2").onclick = openDex;
  $("dex-close").onclick = () => {
    $("dex").hidden = true;
    $("intro").hidden = false;
    if (myCode && S.mode) { result.hidden = false; scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" }); }
    else home();
  };

  $("share").onclick = async (e) => {
    const b = e.currentTarget;
    const payload = { title: "64 ตำแหน่งในต่างโลก", text: share, url: location.href };
    if (navigator.share) {
      try { await navigator.share(payload); return; }
      catch (err) { if (err && err.name === "AbortError") return; } // ผู้ใช้กดปิดเอง ไม่ต้องทำอะไรต่อ
    }
    try { await navigator.clipboard.writeText(share + "\n" + location.href); b.textContent = "คัดลอกลิงก์แล้ว"; }
    catch (err) { b.textContent = "แชร์ไม่ได้ ลองคัดลอกเอา"; }
    setTimeout(() => { b.textContent = "แชร์ให้ผู้อื่น"; }, 2200);
  };

  $("copy").onclick = async (e) => {
    const b = e.currentTarget;
    try { await navigator.clipboard.writeText(share); b.textContent = "คัดลอกแล้ว"; }
    catch (err) { b.textContent = "คัดลอกไม่ได้ ลองเลือกข้อความเอา"; }
    setTimeout(() => { b.textContent = "คัดลอกไปแปะในแชท"; }, 2200);
  };

  if (S.mode) run();
</script>
