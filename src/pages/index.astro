---
import { AXES, QUESTIONS, CHOICES, DRAW, DEPTHS } from "../data/questions.js";
import { TYPES, GUILDS, ARCHETYPES } from "../data/types.js";
import { ICONS } from "../data/icons.js";

// เบราว์เซอร์บางตัว (webview ใน LINE/แอปต่าง ๆ) ไม่มีพจนานุกรมตัดคำไทย เลยตัดบรรทัดกลางคำ
// ตัดคำด้วย Intl.Segmenter ตอน build แล้วคั่นด้วย zero-width space ให้เบราว์เซอร์รู้ว่าตรงไหนตัดได้
const seg = new Intl.Segmenter("th", { granularity: "word" });
const th = (s) => [...seg.segment(s)].map((x) => x.segment).join("​");
const Q = QUESTIONS.map((q) => ({
  ...q,
  text: th(q.text),
  choices: q.choices && q.choices.map(([label, value]) => [th(label), value]),
}));
const CODES = Object.keys(TYPES);
const BASES = [...new Set(CODES.map((c) => c.slice(0, 4)))];
const T = Object.fromEntries(Object.entries(TYPES).map(([k, v]) => [k, {
  ...v,
  name: th(v.name), tag: th(v.tag), over: th(v.over), good: th(v.good), care: th(v.care), grow: th(v.grow),
  roles: v.roles.map(th),
}]));
const A = AXES.map((x) => ({ ...x, labA: th(x.labA), labB: th(x.labB), descA: th(x.descA), descB: th(x.descB) }));
const G = Object.fromEntries(Object.entries(GUILDS).map(([k, v]) => [k, { ...v, line: th(v.line) }]));

const vars = (mode) =>
  AXES.map((x) => `--c-${x.key}:${x[mode]};`).join("") +
  Object.entries(GUILDS).map(([k, g]) => `--g-${k}:${g[mode]};`).join("");
const axisPalette = `
:root{${vars("light")}}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){${vars("dark")}}}
:root[data-theme="dark"]{${vars("dark")}}
`;
---

